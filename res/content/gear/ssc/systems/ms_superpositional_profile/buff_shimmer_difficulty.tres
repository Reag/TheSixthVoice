; SHIMMER's +2 DIFFICULTY on the attack that triggered it (ruling 15): the Saladin's
; buff_warp_shield.tres with bonus_value -2. On the THORN, attack_roll_incoming, until = 8
; (FINISH_ATTACK_ROLL), onetime - so it rides exactly the one roll. Hidden: it lives for one roll,
; but attack_roll.gd:189 draws it in the roll breakdown regardless (HIDDEN_BUFFS_NEEDING_ICONS), so
; SP5 gives it Superpositional Profile's own texture.
[resource]
script = ExtResource("1_bonus")
bonus_subtype = &"accuracy"
bonus_value = -2
until = 8
to = &"attack_roll_incoming"
is_onetime = true
hide_from_player = true
icon = ExtResource("2_icon")
metadata/_custom_type_script = "uid://bav10yhc56w73"

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ssc/systems/ms_pinpoint_mark/buff_hyperfocus.gd" id="1_chip"]

; Hyperfocus's chip on the Thorn (ruling 12). VISIBLE, MANUAL. Flat +1 on attack_roll against the
; stored focus only; its triggers (attack_declared POST, death POST) end the whole effect - see the
; script. SP5: the icon.
[resource]
script = ExtResource("1_chip")
bonus_subtype = &"flat"
bonus_value = 1
to = &"attack_roll"
triggers_on = Array[StringName]([&"attack_declared", &"death"])

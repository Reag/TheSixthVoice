; +1 accuracy (subtype accuracy, not flat) on ATTACK_ROLL; MELEE (2) forbidden; basic attacks
; allowed (an improvised ranged attack has a range too). Hidden: the card is the Kit's own row.
; attack_roll.gd:189 draws it in the roll breakdown regardless (HIDDEN_BUFFS_NEEDING_ICONS), so SP5
; gives it the Kit's own texture rather than leaving it blank.
[resource]
script = ExtResource("1_buff")
bonus_subtype = &"accuracy"
bonus_value = 1
weapon_types_forbidden = Array[int]([2])
allow_basic = true
to = &"attack_roll"
hide_from_player = true
icon = ExtResource("2_icon")

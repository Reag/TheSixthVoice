; Main (1) Cannon (1), flat 3 Kinetic (0), Range 15, SMART / ACCURATE / LOADING in the card's order
; (ruling 11). The ACCURATE tag is display only: the +1 accuracy the roll counts is attack_accuracy
; (attack_roll.gd PreAttack.create reads get_attack_accuracy). SMART targets E-Defense and LOADING
; unloads the gear on use, both inside ActionAttackWeapon / UnitAction.
[resource]
script = ExtResource("1_attack")
damage_type = 0
damage_dice = "3"
weapon_size = 1
weapon_type = 1
aim_range = 15
tags = Array[StringName]([&"smart", &"accurate", &"loading"])
attack_accuracy = "1"
on_hit_effects = Array[ExtResource("2_onhiteffect")]([ExtResource("3_onhit")])

[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_weeping_lance/action_weeping_lance.tres" id="3_lance"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_weeping_lance/action_weeping_lance_autoconsume.tres" id="4_autoconsume"]

; WEEPING LANCE, the Naga's rank-III weapon (SP4 Task 1, design ruling 18). SP 1. The attack is
; actions[0] (get_solo_action); the forced consume is a hidden reaction behind it - reactions on a
; weapon Kit are reached, since LoadoutCore.get_reactions walks get_all_gear, mounts included
; (loadout_core.gd:506-516). The card's Effect paragraph is the gear.mw_weeping_lance.effect row.
; No icon_override until SP5 - the integrity guard's deliberate red.
[resource]
script = ExtResource("2_kit")
actions = Array[ExtResource("1_action")]([ExtResource("3_lance"), ExtResource("4_autoconsume")])
sp_cost = 1
metadata/_custom_type_script = "uid://ckrv6mvs5q65e"

[gd_resource type="Resource" format=3]

[ext_resource type="Script" uid="uid://d2nldg6e3doqd" path="res://engine/character/gear_action/resources/on_hit_effect.gd" id="1_onhit"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_nightfare_nexus/buff_nightfare_soft_cover.tres" id="3_chip"]

; SCRIPT-LESS, on the ENGINE's own OnHitEffect - onhit_rend_nexus.tres one folder over is the mod's
; nearest precedent and onhit_diversion_rail.tres is the oldest. Nothing here needs code.
;
; apply_on IS LEFT UNSET, which is the export's own default of STAGE.ON_HIT (on_hit_effect.gd:8, :12).
; Written out here rather than declared, because the Rend Nexus beside this file DOES declare
; `apply_on = 2` for its ON_CRIT, and a reader comparing the two would otherwise take the silence for
; an omission. The card says "on hit", the default says ON_HIT, and test_the_kit_carries_one_on_hit_
; effect_that_buffs_the_target asserts the value rather than the absence.
;
; apply_buffs_to_self IS ALSO LEFT UNSET (default false), AND THAT IS THE WHOLE DIFFERENCE FROM THE
; REND NEXUS. With it false, apply_statuses_and_buffs sends the buffs to `attacked_unit` and passes
; `context.gear` alongside them (on_hit_effect.gd:86-88) - so the chip lands on the TARGET and is
; OWNED by the Sluagh's weapon, which is the pair of facts the chip's until = 6 depends on. Setting
; it true would move the cover onto the Sluagh and quietly make this card shelter the wrong mech.
[resource]
script = ExtResource("1_onhit")
apply_on = 1
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])

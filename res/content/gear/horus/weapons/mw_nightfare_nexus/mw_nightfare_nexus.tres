; NIGHTFARE NEXUS, the Sluagh's rank-II Auxiliary Nexus (SP3 Task 1). SP 0, one action, no passives.
; The whole ability is declarative: see action_nightfare_nexus.tres and onhit_nightfare_nexus.tres.
;
; NO system_tags. The card lists only SMART, which is a WEAPON tag and lives on the action; the Kit's
; system_tags flags (Unique, Indestructible, AI, NHP, Shield - kit.gd:30) are all system-side and none
; of them applies to a weapon.
[resource]
script = ExtResource("2_kit")
actions = Array[ExtResource("1_action")]([ExtResource("3_shot")])
sp_cost = 0
icon_override = ExtResource("4_icon")

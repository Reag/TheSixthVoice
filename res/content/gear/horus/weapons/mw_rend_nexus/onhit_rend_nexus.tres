[gd_resource type="Resource" format=3]

[ext_resource type="Script" uid="uid://d2nldg6e3doqd" path="res://engine/character/gear_action/resources/on_hit_effect.gd" id="1_onhit"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_rend_nexus/buff_rend_nexus.tres" id="3_chip"]

; SCRIPT-LESS, on the ENGINE's own OnHitEffect - the mod's onhit_diversion_rail.tres is the precedent
; for a pure-data one and onhit_ddmr.tres for apply_buffs_to_self. Nothing here needs code.
;
; apply_on = 2 is STAGE.ON_CRIT (on_hit_effect.gd:8). The crit pass runs at event_unit_attack.gd:92,
; nested inside `if roll.hit:` at :83 and AFTER the ON_HIT pass - so a plain hit reaches this file and
; apply_statuses_and_buffs returns at its first line (:77, `if apply_on != stage: return`).
;
; apply_buffs_to_self sends the buff to activation.context.unit, the ATTACKER (:85-86). The card says
; "the next attack against YOU", and "you" is the Sluagh.
[resource]
script = ExtResource("1_onhit")
apply_on = 2
apply_buffs_to_self = true
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])

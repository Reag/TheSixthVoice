[ext_resource type="Script" uid="uid://vi3dfs5ql3lg" path="res://engine/character/gear_action/action_attack_weapon.gd" id="1_attack"]
[ext_resource type="Script" uid="uid://d2nldg6e3doqd" path="res://engine/character/gear_action/resources/on_hit_effect.gd" id="2_onhiteffect"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_rend_nexus/onhit_rend_nexus.tres" id="3_onhit"]

; THREAT IS LEFT UNSET, which is the archetype default of 1 (action_attack_weapon.gd:16) and is what
; vanilla's own mw_nexus_light.tres does with the identical profile shape. The card gives a Range and
; no Threat, and a Nexus is never a melee weapon, so the default is both right and unremarkable -
; recorded here only because the spec pins the value and a reader would otherwise look for the line.
;
; SMART makes this roll against E-DEFENCE rather than evasion (action_attack_weapon.gd:250-252), which
; is the tag doing its job and is why the spec's fixture asserts damage landed rather than assuming a
; cheated d20 cleared a number it never read.
[resource]
script = ExtResource("1_attack")
damage_type = 1
damage_dice = "1d3+1"
weapon_size = 1
weapon_type = 5
aim_range = 10
tags = Array[StringName]([&"ap", &"smart"])
on_hit_effects = Array[ExtResource("2_onhiteffect")]([ExtResource("3_onhit")])

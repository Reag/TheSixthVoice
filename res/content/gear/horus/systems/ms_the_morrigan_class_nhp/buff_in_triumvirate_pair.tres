[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_the_morrigan_class_nhp/buff_in_triumvirate_pair.gd" id="1_pair"]

[resource]
script = ExtResource("1_pair")
; THE CHANNEL. Not in Buff.TO and not in ExportListHint.BUFF_TO - a suggestion hint, not a
; constraint - exactly as talents' &"adjacency_range" is not. Read only by our banner.
to = &"reag_adjacent_to"
; until = 7 is Lancer.UNTIL.END_OF_OWNERS_NEXT_TURN (lancer.gd:52): cleared by
; clear_owners_turn_statuses at the OWNER's turn end, the owner being the Sluagh through from_gear.
; The engine's own warning on that line is fork 3's recorded edge.
until = 7
; VISIBLE (ruling 23): a chip on each end says who is paired. Its icon is SP5's.
;
; IT HAS ROWS OF ITS OWN - gear.buff_in_triumvirate_pair.name / .effect (final review, item 1).
; Without them Translate.buff falls through to the OWNER GEAR's actions[0] (translate.gd:72-77) =
; In Triumvirate, so BOTH ends' chips read the Sluagh's targeting sentence at a unit that is not
; choosing anything. Its own effect row states the paired unit's side of the card instead: "Always
; treated as adjacent to your partner while within the Sluagh's Sensors." One row pair serves both
; ends deliberately - the sentence is true read from either chip, and the ALLY is the one who needs
; it, since the Sluagh can read the NHP's card. test_in_triumvirate.test_the_card_rows_resolve pins
; the rows and asserts the chip renders them rather than the action's.

[gd_resource type="Resource" script_class="BuffBonus" format=3]

[ext_resource type="Script" uid="uid://bav10yhc56w73" path="res://engine/character/buff/archtypes/buff_bonus.gd" id="1_bonus"]

[resource]
script = ExtResource("1_bonus")
; "all attacks against them gain +1 difficulty": accuracy -1 on the INCOMING roll channel, which
; attack_roll.gd reads off the DEFENDER. buff_wicked_host.tres is the same file with is_onetime;
; this one is NOT one-time, because the card says ALL attacks, for the clock's length.
bonus_subtype = &"accuracy"
bonus_value = -1
to = &"attack_roll_incoming"
until = 7
; VISIBLE (ruling 23). Its icon is SP5's; BuffBonus.get_icon's difficulty-svg fallback covers the
; roll breakdown meanwhile, but the status bar wants a real one.

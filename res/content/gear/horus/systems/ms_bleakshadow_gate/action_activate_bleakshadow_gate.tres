[gd_resource type="Resource" script_class="ActionSystemApplyBuff" format=3]

[ext_resource type="Script" uid="uid://cm50wdj5g8syg" path="res://engine/character/gear_action/archtypes/action_system_apply_buff.gd" id="1_apply"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_bleakshadow_gate/buff_bleakshadow_gate.tres" id="3_chip"]

[resource]
script = ExtResource("1_apply")
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])
; QUICK (Lancer.ACTION.QUICK == 1). ActionSystem.action_type defaults to NONE, which would also
; make show_in_tooltip false and drop the card's own name off the system card.
action_type = 1
; Quick TECH: jammable (action_system.gd:32), and exempt from the repeat-action rule on a player
; mech (:44) - which the AI limit does not care about.
is_tech = true
; "you gain": nothing to target. count 0 (action_system_apply_buff.gd:52-56), one confirm, no picker.
apply_only_to_self = true
; Its own group, separate from the reaction's (unit_action.gd:167-168).
usage_group = &"action_activate_bleakshadow_gate"
emit_text_popcorn_on_use = true

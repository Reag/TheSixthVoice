[resource]
script = ExtResource("2_kit")
; TWO actions as of Task 2: the activate, then EYES OF NIGHT. Each carries its OWN usage_group -
; the Subutai SP2 lesson (GearCore.get_usage_group_for_action, gear_core.gd:166-168, falls back to
; the KIT id when an action names no group): two actions sharing that default would lock each other
; out.
actions = Array[ExtResource("1_action")]([ExtResource("3_activate"), ExtResource("4_eyes")])
sp_cost = 2
; UNIQUE = 1 (kit.gd:30). Not AI, not NHP, not SHIELD: the card carries only UNIQUE.
system_tags = 1
icon_override = ExtResource("5_icon")
metadata/_custom_type_script = "uid://ckrv6mvs5q65e"

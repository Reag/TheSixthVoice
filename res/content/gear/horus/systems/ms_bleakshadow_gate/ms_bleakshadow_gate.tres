[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="2_kit"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_bleakshadow_gate/action_activate_bleakshadow_gate.tres" id="3_activate"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_bleakshadow_gate/action_eyes_of_night.tres" id="4_eyes"]

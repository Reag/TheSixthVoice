; PING (ruling 11). An invade (is_invade: auto-hit on an ally, 2 heat on a hostile). Everything the card
; does is onhit_ping: the lock through the shared hook, and the chip that carries the Impaired. SP5:
; an outward pulse - its own named family, separate from Hypnotize; buff_ping wears the same file.
[resource]
script = ExtResource("1_tech")
is_invade = true
on_hit_effects = Array[ExtResource("2_onhiteffect")]([ExtResource("3_onhit")])
usage_group = &"ping"
icon_override = ExtResource("4_icon")

; "This lasts until they succeed on a Systems check as a quick action." (ruling 13) Hack/Slash's
; action_hack_slash_clear.tres verbatim: make_save_type 2 (SYS), a CHECK not a save, QUICK (1),
; SITUATIONAL, and its own usage group - the archetype's own two reminders.
[resource]
script = ExtResource("3_clear")
clear_buffs = Array[ExtResource("1_buff")]([ExtResource("2_chip")])
make_save_type = 2
is_check_instead_of_save = true
action_type = 1
is_situationally_activated = true
usage_group = &"hypnotize_clear"

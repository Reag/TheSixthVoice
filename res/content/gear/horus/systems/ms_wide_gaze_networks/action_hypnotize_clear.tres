[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_wide_gaze_networks/buff_hypnotized.tres" id="2_chip"]
[ext_resource type="Script" uid="uid://dmy7tfomr856j" path="res://engine/character/gear_action/archtypes/action_system_clear_buff.gd" id="3_clear"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/action_hypnotize.svg" id="4_icon"]

; "This lasts until they succeed on a Systems check as a quick action." (ruling 13) Hack/Slash's
; action_hack_slash_clear.tres verbatim: make_save_type 2 (SYS), a CHECK not a save, QUICK (1),
; SITUATIONAL, and its own usage group - the archetype's own two reminders. SITUATIONAL still reaches a
; bar - the Hypnotized TARGET's situational list (unit_action.gd:31-53 -> gear_bar.gd:91-102) - so it
; wears the Hypnotize family's glyph (the chip's own), not the Kit's (naga close, slice 6 #4).
[resource]
script = ExtResource("3_clear")
clear_buffs = Array[ExtResource("1_buff")]([ExtResource("2_chip")])
make_save_type = 2
is_check_instead_of_save = true
action_type = 1
is_situationally_activated = true
usage_group = &"hypnotize_clear"
icon_override = ExtResource("4_icon")

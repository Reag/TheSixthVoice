[ext_resource type="Script" uid="uid://dw0igjjw1k5s3" path="res://engine/character/gear_passive/passive_aura.gd" id="1_aura"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_wide_gaze_networks/buff_hypnotize_targeting.tres" id="3_targeting"]

; HYPNOTIZE'S TARGETING RULE, ATTACKER-SIDE (ruling 12). WEAPON_TAG buffs are read off the ATTACKER
; (action_attack_weapon.gd:170), so the rule has to be ON every allied attacker, and this always-on
; map-wide aura is how it gets there: self and allies, never enemies, characters only (the drone
; exclusion is the buff's own is_actor gate - is_character() lets a drone through). No LOS.
[resource]
script = ExtResource("1_aura")
buffs = Array[ExtResource("2_buff")]([ExtResource("3_targeting")])
aura_range = 99
applies_to_enemies = false

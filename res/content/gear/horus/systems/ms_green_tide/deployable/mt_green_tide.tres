; THE PICTURE: vanilla's HORUS nanite haze (fxe_nanites.tscn - the Hive Drone's, mt_hive_drone.tres)
; over the Blast 1, radius 1 around the size-1 marker. Every gameplay export on the DynamicZone is
; left at its inert default (passive_fungal_network_zone.tres has the full accounting): it blocks no
; sight, fences no move, steers no AI. is_fxe_at_unit_tiles stays TRUE - the marker's tile is the
; centre of the area, not a mech to keep clear.
[sub_resource type="Resource" id="Resource_shape"]
script = ExtResource("5_zone")
radius = 1

[sub_resource type="Resource" id="Resource_picture"]
script = ExtResource("6_dynzone")
dynamic_zone = SubResource("Resource_shape")
fxe = ExtResource("7_fx")

; THE GREENWASH SWARM, the marker's own trait (design ruling 16): the surge reaction and the picture.
[resource]
script = ExtResource("3_kit")
actions = Array[ExtResource("1_action")]([ExtResource("4_surge")])
passives = Array[ExtResource("2_passive")]([SubResource("Resource_picture")])
is_trait = true

; THE GREENWASH SWARM (design ruling 15). A MARKER (entity_type = 2): no attacks, no cover, no sight,
; nothing to stand on - the Plasma Thrower flames' deployable, whose empty.png sprite it shares, so the
; nanite haze on mt_green_tide is the whole picture. statblock_zero: size 1.
;
; is_deactivated_on_owner_death is LEFT AT ITS TRUE DEFAULT (frame.gd:65), unlike the Maar: the swarm
; is the Naga's own nanites and goes with it (EventService.remove_unit_from_game, event_service.gd:56-63).
[resource]
script = ExtResource("1_frame")
sprites = Array[Texture2D]([ExtResource("3_sprite")])
traits = Array[ExtResource("2_kit")]([ExtResource("5_swarm"), ExtResource("6_expiry")])
stat = ExtResource("4_statblock")
entity_type = 2
is_obstruction = false

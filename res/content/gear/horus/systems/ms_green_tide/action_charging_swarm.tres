[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/systems/ms_green_tide/deployable/dep_green_tide.tres" id="2_swarm"]
[ext_resource type="Script" uid="uid://c0yv6pnw2be6l" path="res://engine/character/gear_action/resources/range_pattern.gd" id="3_rangepattern"]
[ext_resource type="Script" uid="uid://df1yicp7kbf3x" path="res://engine/character/gear_action/resources/target_requirements.gd" id="4_targetreqs"]

; BLAST 1 (Lancer.AOE_TYPE.BLAST == 1): the targeting preview. The swarm's own reach is its range-1
; surge around the single marker laid at the centre.
[sub_resource type="Resource" id="Resource_blast1"]
script = ExtResource("3_rangepattern")
pattern = 1
value = 1

[sub_resource type="Resource" id="Resource_targeting"]
script = ExtResource("4_targetreqs")
count = 1
range_pattern = SubResource("Resource_blast1")
can_target_empty_tiles = true
can_target_units = false

; CHARGING SWARM (design ruling 15): vanilla's ActionSystemDeploy, SCRIPTLESS - the archetype's own
; activate is the whole card, and it spawns the marker in the NAGA'S faction (place_deployable,
; action_system_deploy.gd:117), which is why this is not the Maar's Terrain.lay. No hostile filter:
; the card puts none on the area.
;
; deploy_to_sensors: "within sensors", the engine's only range = Sensors idiom. The card names no
; line of sight, so requires_line_of_sight_baseline = false (action.gd:36; needs_los is a dead
; export, the Maar's header). ONE marker per press (deploy_to_every_aoe_space false) and presses
; stack (remove_previous_deployments false): each lasts until the Naga's next turn start. QUICK (1),
; HEAT SELF 1 as the vanilla self_heat_dice string.
[resource]
script = ExtResource("1_deploy")
deployable_frame = ExtResource("2_swarm")
deploy_to_sensors = true
deploy_to_every_aoe_space = false
remove_previous_deployments = false
disable_while_deployed = false
requires_line_of_sight_baseline = false
action_type = 1
self_heat_dice = "1"
target_requirements_override = SubResource("Resource_targeting")
usage_group = &"charging_swarm"
emit_text_popcorn_on_use = true

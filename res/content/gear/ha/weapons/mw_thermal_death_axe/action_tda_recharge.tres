[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/weapons/mw_thermal_death_axe/action_tda_recharge.gd" id="1_recharge"]

; end_turn / PRE, point-free - Toe To Toe's four lines minus counts_as_free_action (this is not an
; action the player takes). trigger_timing = 0 is ReactionBus.TIMING.PRE. Hidden via the script's
; show_in_tooltip, so it never reaches ICON_TARGETS.
;
; NO usage_group of its own: nothing here is ever spent, so nothing is tallied, and sharing the
; weapon's group would count the recharge against the turn's one Skirmish.
[resource]
script = ExtResource("1_recharge")
triggers_on = Array[StringName]([&"end_turn"])
trigger_timing = 0
consumes_rxn = false

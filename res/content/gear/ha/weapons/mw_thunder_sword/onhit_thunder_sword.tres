[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/weapons/mw_thunder_sword/onhit_thunder_sword.gd" id="1_onhit"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/weapons/mw_thunder_sword/buff_thunder_sword.tres" id="3_chip"]

; NO LONGER SCRIPT-LESS (bug fix, confirmed review): the bare engine OnHitEffect
; (onhit_rend_nexus.tres is the in-mod precedent for going scriptless) applies buffs to
; attacked_unit with no actor filter (on_hit_effect.gd:83-88), so this landed buff_thunder_sword on
; DRONES - the card says "the damaged character" and the mod-wide rule (ruling 22) is that a drone
; is not one. onhit_thunder_sword.gd's should_abort override is the only change; every export below
; is unchanged.
;
; apply_on is OMITTED: STAGE.ON_HIT is the export's own default (on_hit_effect.gd:12) and ON_HIT is
; the card's stage. apply_buffs_to_self is OMITTED: false is the default, and false is the target.
[resource]
script = ExtResource("1_onhit")
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])

[gd_resource type="Resource" script_class="Kit" format=3]

[ext_resource type="Script" uid="uid://b8unc74nyhjr0" path="res://engine/character/gear_action/action.gd" id="1_action"]
[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="2_kit"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/weapons/mw_thunder_sword/action_thunder_sword.tres" id="3_swing"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/mw_thunder_sword.svg" id="4_icon"]

; THE THUNDER SWORD, the Leoleth's rank-I Main Melee weapon (SP2 Task 1). SP 0, one action, no
; passives. The whole ability is declarative: see action_thunder_sword.tres and
; onhit_thunder_sword.tres.
;
; THIS KIT HAS NO gear.mw_thunder_sword.effect ROW, on purpose (design 2.1): a weapon's card text is
; the action's on_hit row. That is exactly why buff_thunder_sword carries its OWN effect row - with
; no Kit .effect to fall through to, a row-less chip renders a RAW KEY (the house rule taken at the
; Sluagh close). mw_rend_nexus.tres is the same shape.
;
; SP5: a long blade with one lightning notch, inside the shared ring register. action_thunder_sword
; is a KIT row (one Kit, one action) and carries no icon_override of its own.
[resource]
script = ExtResource("2_kit")
actions = Array[ExtResource("1_action")]([ExtResource("3_swing")])
sp_cost = 0
icon_override = ExtResource("4_icon")
metadata/_custom_type_script = "uid://ckrv6mvs5q65e"

[gd_resource type="Resource" format=3]

[ext_resource type="Script" uid="uid://vi3dfs5ql3lg" path="res://engine/character/gear_action/action_attack_weapon.gd" id="1_attack"]
[ext_resource type="Script" uid="uid://d2nldg6e3doqd" path="res://engine/character/gear_action/resources/on_hit_effect.gd" id="2_onhiteffect"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/weapons/mw_thunder_sword/onhit_thunder_sword.tres" id="3_onhit"]

; THREAT IS LEFT UNSET, which is the archetype default of 1 (action_attack_weapon.gd:16) and is the
; card's Threat 1 - the same reasoning action_rend_nexus.tres records. The export is `threat`; do not
; look for `threat_range`, which is a BuffWeaponTypeBonus subtype and a different thing entirely
; (ruling 11 uses it for RAGE's Reach).
;
; weapon_size = 1 is MAIN and weapon_type = 2 is MELEE (Lancer.WEAPON_SIZE / WEAPON_TYPE,
; lancer.gd:104, :107). damage_type is OMITTED: KINETIC is 0 and the export's default.
;
; NO TAGS. The card's only tag is HEAT SELF 1, which is not a weapon tag at all - it is
; Action.self_heat_dice (action.gd:39), a dice STRING, so "1" and not 1.
;
; NO icon_override in SP2; SP5 gives this Kit its glyph and the action inherits it (a KIT row in
; test_content_integrity.ICON_TARGETS).
[resource]
script = ExtResource("1_attack")
damage_dice = "1d6"
weapon_size = 1
weapon_type = 2
aim_range = 0
self_heat_dice = "1"
on_hit_effects = Array[ExtResource("2_onhiteffect")]([ExtResource("3_onhit")])

; JUXTAPOSITION AUGMENTS, the Koremasa's rank-III weapon mod (SP5, design ruling 30). SP 2; fits
; Melee (weapon_type 2) of sizes Auxiliary, Main, Heavy (0, 1, 2 - not Superheavy), lancer.gd:104,
; :107. system_tags 1 is UNIQUE (kit.gd:30), the sheet's "Adds tags: UNIQUE" - the wm_greenlight_projection
; reading.
;
; The chip is re-armed at every turn start and applied at combat start; the ON_ATTACK effect spends it
; after the weapon's first attack whether it applied or not.
;
; NO icon_override yet: SP6.
[sub_resource type="Resource" id="Resource_juxtaposition"]
script = ExtResource("3_weaponmod")
allowed_sizes = Array[int]([0, 1, 2])
allowed_types = Array[int]([2])
on_hit_effects = Array[ExtResource("5_onhiteffect")]([ExtResource("7_spend")])
applied_buffs = Array[ExtResource("4_buff")]([ExtResource("6_chip")])
reapply_at_the_start_of_each_turn = true

[resource]
script = ExtResource("1_kit")
passives = Array[ExtResource("2_passive")]([SubResource("Resource_juxtaposition")])
sp_cost = 2
system_tags = 1
metadata/_custom_type_script = "uid://ckrv6mvs5q65e"
icon_override = ExtResource("8_icon")

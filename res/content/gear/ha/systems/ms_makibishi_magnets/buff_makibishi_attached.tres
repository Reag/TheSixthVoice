[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/systems/ms_makibishi_magnets/buff_makibishi_attached.gd" id="1_buff"]

; VISIBLE: the victim wears the magnets (VISIBLE_BUFFS). until 0 = MANUAL. triggers_on step: the
; Drag Down shape. log_on_application pops the name as it lands. SP6 draws its icon (the Makibishi
; family).
[resource]
script = ExtResource("1_buff")
applies_statuses = Array[StringName]([&"impaired"])
until = 0
triggers_on = Array[StringName]([&"step"])
log_on_application = true

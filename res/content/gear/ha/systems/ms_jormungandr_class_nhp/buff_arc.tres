[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/systems/ms_jormungandr_class_nhp/buff_arc.gd" id="1_arc"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/ms_jormungandr_class_nhp.svg" id="2_icon"]

[resource]
script = ExtResource("1_arc")
; TWO TRIGGERS ON ONE CHIP, both at POST (ReactionBus.TIMING.POST is 1). attack_declared POST is the
; heat toll; new_turn POST is the deactivation, and POST is the only timing that works for it - the
; PRE queue at event_turn_start.gd:14 runs BEFORE handle_starting_unit, so a chip cleared there
; would be gone before the turn it is meant to survive has properly begun.
triggers_on = Array[StringName]([&"attack_declared", &"new_turn"])
trigger_timing = 1
; `until` is omitted: Lancer.UNTIL.MANUAL is UNTIL's own zero (lancer.gd:46-47). The A.R.C. runs
; until the player begins to deactivate it - nothing else ends it, which is exactly why
; test_the_chip_survives_a_turn_start_when_the_protocol_was_never_pressed is the stamp's control.
; No `to`: this buff is purely a trigger; the +1d6 channel is buff_arc_bonus.
; VISIBLE. SP5 gives this chip the same ouroboros glyph as the Kit and its two protocols and
; reaction - one glyph family, per design ruling 17.
log_on_application = true
icon = ExtResource("2_icon")

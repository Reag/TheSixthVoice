[gd_resource type="Resource" script_class="ActionSystemApplyBuff" format=3]

[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Script" uid="uid://cm50wdj5g8syg" path="res://engine/character/gear_action/archtypes/action_system_apply_buff.gd" id="2_apply"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/systems/ms_zip_type_engine/buff_zip_type_engine.tres" id="3_chip"]

; ENGAGE. action_type = 3 is FREE (lancer.gd:27). can_reapply FALSE is the availability gate: the
; archetype refuses while the chip from this gear is held (action_system_apply_buff.gd:36), and
; hide_if_disabled then removes the button so only ONE of the pair shows at a time - the vanilla
; Retractable Profile shape. NO icon_override: family KIT, it wears the Kit's glyph (the engaged
; ring-and-bolt), and action_zip_disengage wears the struck-through one.
[resource]
script = ExtResource("2_apply")
buffs = Array[ExtResource("1_buff")]([ExtResource("3_chip")])
apply_range = 0
apply_only_to_self = true
can_apply_to_self = true
can_reapply = false
action_type = 3
usage_group = &"zip_engage"
hide_if_disabled = true
metadata/_custom_type_script = "uid://cm50wdj5g8syg"

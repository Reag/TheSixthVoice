[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/systems/ms_zip_type_engine/action_zip_disengage.gd" id="2_clear"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/ha/systems/ms_zip_type_engine/buff_zip_type_engine.tres" id="3_chip"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/action_zip_disengage.svg" id="4_icon"]

; DISENGAGE. FREE, its OWN usage group (the archetype's own reminder: a different group from the
; main action), no save. Its own glyph - the author asked that on and off differ at a glance.
;
; metatags = [deactivate] (Pass F Task 15, ruling 2026-09-27 "ZIP disengage and a forced
; deactivate"): the sanctioned channel a Napoleon's Trueblack Aegis reads (action.gd METATAG
; comment: "napoleon CP activates this") - action_activate_aegis.gd:22 fires any deactivate-tagged
; action on a gear it is shutting down, and buff_trueblack_aegis_restrictions.gd:19 exempts it from
; the Aegis' own action_forbidden lockdown. The Aegis already clears the chip directly regardless
; (action_activate_aegis.gd:44-50, is_buff_prohibited); this closes the OTHER half - disengage no
; longer reads FORBIDDEN under the restriction once it is up.
[resource]
script = ExtResource("2_clear")
clear_buffs = Array[ExtResource("1_buff")]([ExtResource("3_chip")])
make_save = false
action_type = 3
usage_group = &"zip_disengage"
icon_override = ExtResource("4_icon")
hide_if_disabled = true
metatags = Array[StringName]([&"deactivate"])

; THE ZIP TYPE ENGINE, the Leoleth's rank-II system (SP3 Task 2). system_tags = 1 is UNIQUE, SP 2.
; A toggle: engage (family KIT - no icon_override of its own) and disengage (its own glyph).
; Icons ship HERE, not at SP5, at the author's ask.
[resource]
script = ExtResource("2_kit")
actions = Array[ExtResource("1_action")]([ExtResource("3_engage"), ExtResource("4_disengage")])
sp_cost = 2
system_tags = 1
icon_override = ExtResource("5_icon")

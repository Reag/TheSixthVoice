; VANISH'S SMOKE: vanilla's dep_smoke_cloud_2.tres with the mod's own zone. A blank MARKER, not an
; obstruction, with vanilla's expiration trait - buff_expiration.gd ticks on the OWNER's turns
; (Terrain.lay records the Koremasa), so the cloud outlasts the turn it is laid in and dies at the end
; of the Koremasa's next one: "until the end of your next turn, at which point the smoke vanishes".
[resource]
script = ExtResource("1_frame")
sprites = Array[Texture2D]([ExtResource("3_sprite")])
traits = Array[ExtResource("2_kit")]([ExtResource("5_zone"), ExtResource("6_expiration")])
stat = ExtResource("4_stat")
entity_type = 2
is_obstruction = false
; Vanilla smoke's own line: the cloud lingers if the Koremasa dies, and buff_expiration's NEW_ROUND
; branch ends it a round later instead.
is_deactivated_on_owner_death = false

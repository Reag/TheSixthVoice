; Main (1) Launcher (4), 1d6 Explosive (2), Range 10, Blast 1 (Hazard design ruling 8). ARCING,
; RELIABLE 2 and INACCURATE in the card's order; LIMITED 4 is the Kit's charges_max. No script:
; ARCING waives LOS inside ActionAttackWeapon, RELIABLE's value is reliable_damage, and the
; INACCURATE d6 comes from attack_accuracy (attack_roll.gd:145-151) - the tag only draws it, the
; vanilla Mortar's pairing. The Blast sub-resource is the Mortar's (pattern 1, value 1); the FX is
; the Rocket-Propelled Grenade's, the nearest vanilla launcher grenade.
[sub_resource type="Resource" id="Resource_blast1"]
script = ExtResource("2_pattern")
pattern = 1
value = 1

[resource]
script = ExtResource("1_attack")
damage_type = 2
damage_dice = "1d6"
weapon_type = 4
aim_range = 10
tags = Array[StringName]([&"arcing", &"reliable", &"inaccurate"])
reliable_damage = "2"
range_pattern = SubResource("Resource_blast1")
attack_accuracy = "-1"
attack_fxg_override = ExtResource("3_fxg")

[sub_resource type="Resource" id="Resource_brigid_ai"]
script = ExtResource("6_ai_privilege")
; THE FACE, THE NAME AND THE VOICE, from UnitPrinter.full_repair ->
; PassiveAiPrivilege.inherit_default_nhp_settings (passive_ai_privilege.gd:61-79) - the Morrigan's
; wiring verbatim; ms_the_morrigan_class_nhp.tres has the long form. The name is gated on the
; portrait, so both ship together; brigid.json ships is_stock TRUE (the portrait editor exports
; false) so a player who later swaps NHPs gets that NHP's face. Limit flags at their defaults: an
; ordinary one-per-mech AI.
default_portrait = ExtResource("7_portrait")
default_barkset = ExtResource("8_barkset")

[resource]
script = ExtResource("2_kit")
actions = Array[ExtResource("1_action")]([ExtResource("3_cry")])
passives = Array[ExtResource("5_passive")]([SubResource("Resource_brigid_ai")])
sp_cost = 2
; Unique 1 + AI 4 + NHP 8 = 13. The card prints LIMITED 4, AI, UNIQUE, and design ruling 13 set 5;
; SP4 corrected it to 13 because UnitCore.has_nhp_copilot() reads the NHP bit and nothing else
; (unit_core.gd:319), and that is what lets the NHP speak (unit_bark.gd:39) and shows her face on
; the token, tooltip, sheet and roster. With 5 the barkset and portrait would be adopted and never
; used. Every vanilla NHP, the Morrigan and the Jormungandr carry 13. The one visible cost is an NHP
; chip on the character sheet's tag row (kit.gd:99-100).
system_tags = 13
; LIMITED 4: each Rallying Cry spends one through the default consumes_charges; an empty Kit is
; not a destruction candidate (unit_printer.gd:311-319, vanilla).
charges_max = 4
; 1/scene (unit_action.gd:147, REASON.PER_SCENE), reset by GearCore.short_repair (gear_core.gd:133),
; which leaves the charges alone. ONE ACTION, so no usage_group: the tally falls back to the Kit id.
uses_per_scene = 1
metadata/_custom_type_script = "uid://ckrv6mvs5q65e"
icon_override = ExtResource("9_icon")

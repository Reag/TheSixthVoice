[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/shared/armor/buff_armor_statblock.gd" id="1_buff"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/buff_reinforcement_blast.svg" id="2_icon"]

[resource]
script = ExtResource("1_buff")
icon = ExtResource("2_icon")
; Buff.TO.STATBLOCK - the DISPLAY channel. See the script header: this half reduces no damage.
to = &"statblock"
; The card's "gain 1 armor". buff_armor_statblock.gd:61 defaults this to 1 already - written
; explicitly anyway, matching the Myconid's own two users of this script (buff_uffish_gyre_armor.tres,
; buff_fungal_network_armor.tres), so the number is checkable against the card without opening the
; script. FOLDED HERE 2026-09-16 (frame close): this .tres used to point at its own dedicated
; buff_reinforcement_blast.gd, deleted at the same time - see buff_armor_statblock.gd's header.
armor_amount = 1
; Lancer.UNTIL.END_OF_OWNERS_NEXT_TURN. SEVEN, not six - six is START_OF_OWNERS_TURN
; (lancer.gd:46-54). "until the end of YOUR next turn": the clock is the Fitzgerald's, not the
; target's, which is what END_OF_NEXT_TURN (1) would have meant.
until = 7
; hide_from_player is deliberately LEFT AT ITS FALSE DEFAULT. This is SP4's one player-visible buff:
; the armor chip is the only signal on the map that the blast landed. test_content_integrity.gd's
; VISIBLE_BUFFS lists it for that reason, and the SP5 icon pass owes it an icon.

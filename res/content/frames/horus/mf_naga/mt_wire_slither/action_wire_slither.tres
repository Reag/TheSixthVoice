[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/horus/mf_naga/mt_wire_slither/action_wire_slither.gd" id="1_action"]
[ext_resource type="Script" uid="uid://udxarj3kb6nm" path="res://engine/character/unit/movement_type.gd" id="2_movementtype"]

; "This movement ignores engagement and doesn't provoke reactions." VOLUNTARY (the Naga picks the
; path and it is its own move), with both card clauses as explicit flags rather than through
; `not voluntary` - so nothing else `not voluntary` implies (difficult terrain ignored, fall damage
; taken) rides along. merge_with_standard_move_type on the resource below merges the Naga's own
; standard type (flying, intangible, movement buffs) in at activation.
[sub_resource type="Resource" id="Resource_movetype"]
script = ExtResource("2_movementtype")
voluntary = true
ignore_rxns = true
ignore_engagement = true

; trigger_timing 1 is POST (unit_action POST fires only once the gear's use count rose);
; triggering_unit_is 0 is OWNER_IS.UNIT (the triggering unit must be the holder); moving_unit_is 2 is
; OWNER_IS.HOLDER (the Naga moves). consumes_rxn false: a trait, not a reaction point;
; counts_as_free_action false: a Tech Action granted off-turn still slithers. is_mandatory false:
; "may" - the picker can be cancelled and cancelling spends nothing.
[resource]
script = ExtResource("1_action")
triggers_on = Array[StringName]([&"unit_action"])
trigger_timing = 1
consumes_rxn = false
counts_as_free_action = false
movement_range_fixed = 2
movement_type = SubResource("Resource_movetype")
merge_with_standard_move_type = true
is_mandatory = false
triggering_unit_is = 0
moving_unit_is = 2
usage_group = &"wire_slither"
emit_text_popcorn_on_use = true

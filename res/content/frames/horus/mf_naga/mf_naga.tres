; DERIVED FROM THE SPRITE ART, NOT LEFT AS THE PLACEHOLDER GRAYS (the Vauban's SP5 ruling, re-run
; here as the Sluagh's was). Measured 2026-09-22 with the same shader-literal test
; palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/(0,v,0)/(0,0,v)/(0,v,v) for v in
; palette_index_r.png's seven red values 51, 85, 119, 153, 187, 221, 255): mf_naga.png (160x160,
; 11,559 opaque pixels) has ZERO channel-encoded pixels, so this scheme is INERT on this sprite
; exactly like the Sluagh's, the Vauban's and the Primrose's - it cannot repaint the token at all.
; So base_0..2 hold the sprite's OWN most-common literal fill colours (a plain colour census,
; excluding the pure-black linework at 219px/0,0,0): the swarm green (56,175,131 - 246px), a
; near-black (16,17,20 - 126px) and the pale green highlight (82,192,151 - 72px), most-used first
; per the Iskander's own slot convention. When real channel-encoded art replaces this sprite, it
; inherits a default that already looks like what the art shows today, instead of grey.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
base_0 = Color(0.21960784, 0.6862745, 0.5137255, 1)
base_1 = Color(0.0627451, 0.06666667, 0.078431375, 1)
base_2 = Color(0.32156864, 0.7529412, 0.5921569, 1)

[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 2
structure = 4
stress = 4
health = 10
armor = 1
evasion = 8
edef = 10
speed = 3
heat = 5
save_target = 10
sensor_range = 8
tech_attack = 1
repairs = 5
systems_points = 7
reactions = 1
activations = 1

[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
; FILLED IN SHEET ORDER, ONE TASK AT A TIME, AND NOW COMPLETE. Task 1 landed only the vanilla
; Exposed Reactor (the sheet's third trait, referenced from content/frames/shared/, never
; authored); Tasks 2 and 3 put mt_wire_slither and mt_advanced_targeting_calculations ahead of it,
; and Task 4 appended cp_shimmering_veil last, so the order is the sheet's. An ext_resource
; pointing at a file that does not exist yet would make this WHOLE resource fail to parse, taking
; the frame out of ContentLibrary with no error a player would ever see - which is why each entry
; lands only once its own files do. test_naga_frame.gd pins the order at the close of SP1.
traits = Array[ExtResource("8_kit")]([ExtResource("10_wireslither"), ExtResource("11_atc"), ExtResource("12_exposedreactor"), ExtResource("13_core")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountflex"), ExtResource("6_mountheavy")])
stat = SubResource("Resource_statblock")
role_primary = 1
role_secondary = 5

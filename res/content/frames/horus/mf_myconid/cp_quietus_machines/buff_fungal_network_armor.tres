[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/shared/armor/buff_armor_statblock.gd" id="1_statblock"]

[resource]
script = ExtResource("1_statblock")
; "all adjacent allies ... have +1 armor" - the DISPLAY half. Read buff_armor_statblock.gd's header,
; and its sibling buff_armor_reduction.gd's: an armor grant in this mod is always TWO buffs, because
; Buff.to holds a single StringName and no engine channel grants real armor. This one shows the
; number and blunts nothing; buff_fungal_network_armor_reduction.tres blunts the damage and shows
; nothing. The aura applies both, and neither alone is the mechanic. Author's ruling 2026-09-14
; (rulings.md row 37), restated for this frame as design ruling 8.
to = &"statblock"
armor_amount = 1
; DELIBERATELY VISIBLE: this chip and the immunity chip are the ally's only signal that the cloud is
; helping. VISIBLE_BUFFS lists it; the SP3 icon pass owes it an icon.
;
; `until` stays at MANUAL, and it MUST MATCH buff_fungal_network_armor_reduction.tres's. The two
; halves disagreeing is how this mechanic tears in half - a chip that no longer blunts anything, or
; damage quietly going missing with nothing on screen to explain it. Here MANUAL is right for both
; because the AURA owns the lifetime: PassiveAura.update_unit clears whatever it applied the moment
; the ally is out of range or the aura goes inactive (passive_aura.gd:55-59).

[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]

[resource]
script = ExtResource("1_buff")
; ENTRAPPED (design 3.1, ruling 24): "only be able to draw line of sight to adjacent spaces" is vanilla
; BLINDED, carried here so status immunity is respected (unit_condition.gd:379-382). It is also the
; marker unit_relation.gd_ext.gd reads for the reaction waiver: whoever OWNS this buff is the unit the
; holder always considers within range, threat and line of sight.
applies_statuses = Array[StringName]([&"blinded"])
; Lancer.UNTIL.START_OF_OWNERS_TURN is 6 (lancer.gd:46-56): the Rakshasa's next turn start (ruling 15).
until = 6
; VISIBLE; SP5: icon.

[gd_resource type="Resource" script_class="ActionReactionAttacked" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/horus/mf_rakshasa/cp_short_wave_disruptors/action_stabilizer_override.gd" id="1_stab"]

[resource]
script = ExtResource("1_stab")
; ATTACKER (1), ENEMIES (2), a HIT.
require_unit_to_be = 1
require_defender_relation = 2
; Off here; the script tests is_character() itself, a drone included (rulings.md, mod-wide row of 2026-09-27).
require_defender_to_be_character = false
require_hit = true
; ANY tech attack, basic included.
allow_weapon = false
allow_tech = true
allow_basic = true
; ATTACK at POST (TIMING.POST = 1).
triggers_on = Array[StringName]([&"attack"])
trigger_timing = 1
; Not a reaction point: "1/round" is the script's own hard limit, counted on this group.
consumes_rxn = false
usage_group = &"stabilizer_override"
; HIDDEN: the save prompt and the log read "Stabilizer Override" (action.gd:348).
localization_key_override = "buff_mask_stabilizer_override"

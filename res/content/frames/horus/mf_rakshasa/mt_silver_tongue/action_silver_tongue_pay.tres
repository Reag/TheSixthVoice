[gd_resource type="Resource" script_class="ActionReactionAttacked" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/horus/mf_rakshasa/mt_silver_tongue/action_silver_tongue_pay.gd" id="1_pay"]

[resource]
script = ExtResource("1_pay")
; ATTACKER (1): the Rakshasa made the (rerolled) attack.
require_unit_to_be = 1
; Any character may be the new target, allies included (ruling 8); the buff already chose the set.
require_defender_to_be_character = false
; Tech attacks only; Fragment Signal is basic gear.
allow_weapon = false
allow_tech = true
allow_basic = true
; ATTACK at PRE (TIMING.PRE = 0): paid before the reroll's own roll.
triggers_on = Array[StringName]([&"attack"])
trigger_timing = 0
; Not a reaction point: "1/round" is the script's own hard limit, counted on this group.
consumes_rxn = false
usage_group = &"silver_tongue"
; The card's price, paid by spend_actions -> UnitAction.gain_self_heat.
self_heat_dice = "2"
; HIDDEN: the log reads "Silver Tongue" and the card does not list this reaction (action.gd:348).
localization_key_override = "mt_silver_tongue"

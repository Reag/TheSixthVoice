reactions = 1
activations = 1

[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
; FILLED IN SHEET ORDER, ONE TASK AT A TIME. Task 2 added mt_wicked_host, Task 3
; mt_the_stealing_of_the_souls_of_the_dead and Task 5 mt_inexorable_formation - which is all three
; LCP sheet traits, so check_content.py --frame sluagh is clean from here on; Task 6 appends
; cp_cry_of_the_hosted_dead, and Task 9 pins the result. An ext_resource pointing at a file that does
; not exist yet would make this WHOLE resource fail to parse, taking the frame out of ContentLibrary
; with no error a player would ever see - which is why each entry lands only once its own files do.
traits = Array[ExtResource("8_kit")]([ExtResource("10_wickedhost"), ExtResource("11_stealing"), ExtResource("12_formation")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountmainaux")])
stat = SubResource("Resource_statblock")
role_primary = 5
role_secondary = 2

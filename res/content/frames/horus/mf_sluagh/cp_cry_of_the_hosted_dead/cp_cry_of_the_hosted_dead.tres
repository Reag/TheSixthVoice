[resource]
script = ExtResource("1_kit")
actions = Array[ExtResource("2_action")]([ExtResource("3_guardian"), ExtResource("5_mark")])
; WHAT PUTS THIS KIT IN LoadoutCore.auras: the PassiveAura added in Task 7. regenerate_caches walks
; get_all_gear(false) and appends any gear whose Kit has_passive_type(PassiveAura)
; (loadout_core.gd:298-301), and that list is what PassiveAura.update_unit iterates (:31). The
; passive extends PassiveAura DIRECTLY, because is_passive_of_type only goes one layer deep
; (kit.gd:161-165).
passives = Array[ExtResource("4_passive")]([ExtResource("6_aura")])
is_trait = true

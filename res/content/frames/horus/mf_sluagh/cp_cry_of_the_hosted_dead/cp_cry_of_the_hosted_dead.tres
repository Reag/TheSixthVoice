[resource]
script = ExtResource("1_kit")
; THREE ACTIONS AND ONE PASSIVE, complete as of Task 8. In card order: Astral Guardian (the LCP's
; passive), the Mark (its active), and the Mark's own reaction - the second bullet of that active,
; which is a reaction rather than part of the QUICK and so has to be its own Action. Each carries its
; OWN usage_group; sharing the Kit's default would let any one of them lock the others out.
actions = Array[ExtResource("2_action")]([ExtResource("3_guardian"), ExtResource("5_mark"), ExtResource("7_retort")])
; WHAT PUTS THIS KIT IN LoadoutCore.auras: the PassiveAura added in Task 7. regenerate_caches walks
; get_all_gear(false) and appends any gear whose Kit has_passive_type(PassiveAura)
; (loadout_core.gd:298-301), and that list is what PassiveAura.update_unit iterates (:31). The
; passive extends PassiveAura DIRECTLY, because is_passive_of_type only goes one layer deep
; (kit.gd:161-165).
passives = Array[ExtResource("4_passive")]([ExtResource("6_aura")])
is_trait = true
icon_override = ExtResource("8_icon")

[gd_resource type="Resource" script_class="ActionSystemApplyBuff" format=3]

[ext_resource type="Script" uid="uid://cm50wdj5g8syg" path="res://engine/character/gear_action/archtypes/action_system_apply_buff.gd" id="1_apply"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/horus/mf_sluagh/cp_cry_of_the_hosted_dead/buff_mark_of_the_dead.tres" id="3_chip"]

[resource]
script = ExtResource("1_apply")
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])
; QUICK (Lancer.ACTION.QUICK == 1, lancer.gd:27). ActionSystem.action_type defaults to NONE, which
; would ALSO make show_in_tooltip return false (action_system.gd:27-29) and drop the card's own name
; off the trait card - so this line is two things at once.
action_type = 1
; THE CORE POWER. action_step_of_mist_and_thunder.tres is this mod's precedent for action_type = 1
; plus consumes_cp, and vanilla's action_charge_rail.tres is the engine's.
consumes_cp = true
; "A dome ... envelops YOU": there is nothing to target. With apply_only_to_self the archetype's
; get_target_requirements returns count 0 (action_system_apply_buff.gd:52-56), so
; UnitTargeting.requires_tile_target is false (unit_targeting.gd:12) and activate takes its
; self-applied branch - one confirm prompt, no picker.
apply_only_to_self = true
; Its own group, separate from the guardian's and the retort's (unit_action.gd:167-168, the Subutai
; SP2 lesson): three actions on one Kit sharing the default group would lock each other out.
usage_group = &"action_mark_of_the_dead"
emit_text_popcorn_on_use = true

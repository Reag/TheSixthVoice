[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/passive_bulwark_aura.gd" id="1_aura"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/buff_rage_bulwark.tres" id="3_chip"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/buff_bulwark_penalty.tres" id="4_penalty"]

[resource]
script = ExtResource("1_aura")
buffs = Array[ExtResource("2_buff")]([ExtResource("4_penalty")])
; Line of sight is the bound the card gives; 99 is "anywhere on this map".
aura_range = 99
applies_only_when_in_los = true
applies_to_self = false
applies_to_allies = false
applies_to_enemies = true
; Gated on the face chip, so the dome exists only on a 5. PassiveAura.update_unit turns the whole
; aura off unless the AURA UNIT holds this buff (passive_aura.gd:40-42).
requires_buff = ExtResource("3_chip")
; applies_only_to_characters is left at its true default (passive_aura.gd:11): it is is_character(),
; the card's word, a drone included (rulings.md, mod-wide row of 2026-09-27). starts_active is left at its true default (:18) because the gate is requires_buff,
; not the gear toggle - SpecFactory.apply_passive_buffs sets is_aura_active on every gear.

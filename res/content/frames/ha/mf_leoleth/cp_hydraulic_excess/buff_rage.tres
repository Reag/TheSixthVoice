[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/buff_rage.svg" id="2_icon"]

[resource]
script = ExtResource("1_buff")
; NO `to`, NO triggers, NO statuses: this chip exists to be READ (by action_rage_roll's gate) and to
; be SEEN. `until` is omitted - Lancer.UNTIL.MANUAL is its own zero, and MANUAL is the engine's
; spelling of "for the rest of the scene".
; VISIBLE, and it is the only sign on the token that the core power is running. It carries its own
; name and effect rows - the whole RAGE table - so it needs no BUFFS_THAT_BORROW_A_CARD entry.
; SP5: the RAGE flame, in its base/neutral tint - the member of the six-chip contact sheet the other
; five are read against. Not the same texture as action_rage.svg: buffs are not family-constrained
; the way ICON_TARGETS rows are, and the engine has no per-buff tint, so "six tints" means six
; separate files, not one shared resource recoloured at runtime.
icon = ExtResource("2_icon")

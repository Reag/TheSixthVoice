[gd_resource type="Resource" script_class="ActionSystemApplyBuff" format=3]

[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Script" uid="uid://cm50wdj5g8syg" path="res://engine/character/gear_action/archtypes/action_system_apply_buff.gd" id="2_applybuff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/buff_rage.tres" id="3_ragechip"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/action_rage.svg" id="4_icon"]

[resource]
script = ExtResource("2_applybuff")
buffs = Array[ExtResource("1_buff")]([ExtResource("3_ragechip")])
apply_only_to_self = true
can_apply_to_self = true
; can_reapply FALSE: the chip lasts the scene, so pressing again would spend a core power the unit no
; longer has and re-hang a chip it already holds.
can_reapply = false
; Lancer.ACTION is { NONE, QUICK, FULL, FREE, PROTOCOL, RXN } (lancer.gd:27), so PROTOCOL is 4.
action_type = 4
consumes_cp = true
; Its OWN usage group. A groupless action falls back to the KIT's compcon_id (gear_core.gd:166-168),
; which would make this protocol share one tally with Combust, the roll and ALL SYSTEMS RED.
usage_group = &"rage"
; RULING 24 (2026-09-22, author on playtest). The card reads "at the start of each of your turns", and
; SP1 built exactly that - so the turn you PRESSED the protocol in got no face at all: that turn's
; NEW_TURN POST had already passed, and was gated off anyway because the chip did not exist yet. The
; designer's intent is that pressing RAGE resolves a face on the spot. The card text is untouched;
; this is an engine divergence recorded as a ruling.
;
; kickstart_sibling_action is vanilla's own hook and needs no script here: once the buffs have landed,
; ActionSystemApplyBuff queues an event_gear_activate for the named sibling action on THIS Kit, with
; AS_FREEBIE, at Priority.ACTIVATE.early_followup (action_system_apply_buff.gd:133-141). That is the
; same activation shape ReactionBus uses to fire a reaction (reaction_bus.gd:54-59), so
; action_rage_roll.activate runs exactly as it does at a turn start. Its triggers_on_event gate is
; not consulted on a direct activation, which is harmless: buff_rage has just been applied, so the
; gate would pass. It is also not blocked by the reaction economy - ActionReaction's
; is_available_to_activate returns true immediately when consumes_rxn is false
; (action_reaction.gd:50), and the roll sets consumes_rxn = false.
;
; THE ROLL IS ADDED, NOT MOVED. The face chip is until = START_OF_TURN, so the next turn start clears
; it and rolls again - press on turn N, face on turn N, a fresh face on turn N+1.
kickstart_sibling_action = &"action_rage_roll"
; SP5 gives this action the RAGE glyph (a single jagged flame, inside the shared ring register),
; which action_combust shares - the identical texture, per the family rule - and which the six
; buff_rage* chips reuse in six tints.
icon_override = ExtResource("4_icon")

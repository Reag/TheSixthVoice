[resource]
script = ExtResource("1_bonus")
; Lancer.WEAPON_TYPE.MELEE is 2 (lancer.gd:107).
weapon_types = Array[int]([2])
bonus_subtype = &"threat_range"
bonus_value = 1
; ACTION_RANGE, which ActionAttackWeapon.threat_distance reads through
; BuffBonus.get_bonus_for_subtype (action_attack_weapon.gd:187-190).
to = &"action_range"
; Lancer.UNTIL.START_OF_TURN (lancer.gd:46-48).
until = 3
; VISIBLE, and it carries the WHOLE card line for this face - the Reliable companion beside it is
; hidden, because two chips for one line would read as two effects. SP5: the RAGE flame in its Reach
; tint (green).
;
; RECORDED, AS THE DDMR'S OWN ROW RECORDS IT: the character sheet shows PRINTED threat (memory
; character-sheet-shows-printed-threat), so the +1 is live in targeting and in the range widget and
; NOT on the sheet.
icon = ExtResource("2_icon")

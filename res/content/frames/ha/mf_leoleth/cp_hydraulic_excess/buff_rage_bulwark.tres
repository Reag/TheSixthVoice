[resource]
script = ExtResource("1_buff")
; NO `to`: this chip exists to be READ (by the aura's requires_buff) and to be SEEN. The penalty it
; gates lives on each hostile, because accuracy on a roll reads the ATTACKER's buffs
; (attack_roll.gd:134).
; Lancer.UNTIL.START_OF_TURN (lancer.gd:46-48) - the RAGE table's "until the start of your next turn".
until = 3
; VISIBLE - one of the six face chips. SP5: the RAGE flame in its Bulwark tint (silver/armour).
icon = ExtResource("2_icon")

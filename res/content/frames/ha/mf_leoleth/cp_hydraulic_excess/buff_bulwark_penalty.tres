[resource]
script = ExtResource("1_penalty")
bonus_subtype = &"accuracy"
bonus_value = -1
to = &"attack_roll"
; NO `until`: the AURA owns this buff's lifetime - PassiveAura.update_unit strips it the moment the
; aura stops being active or the unit leaves range (passive_aura.gd:55-59). A lifetime here would be a
; second, competing clock.
;
; VISIBLE (ruling 2026-09-27, Pass E "Bulwark penalty visibility", settling plan J's HIDDEN flag): a
; player should see the penalty before attacking, not only in the roll breakdown. Carries its own
; effect row (gear.buff_bulwark_penalty.effect, the card sentence verbatim) rather than falling back
; to the core Kit's - attack_roll.gd:189 also draws buff_core.base.icon RAW into the roll breakdown,
; which is why the icon below (reusing buff_rage_bulwark's own tint - one mechanic, one picture,
; whichever side of it is asking) already covered both places before this flip.
icon = ExtResource("2_icon")

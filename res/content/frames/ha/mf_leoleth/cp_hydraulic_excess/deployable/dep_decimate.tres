[ext_resource type="Script" uid="uid://daycu0mqh1rbq" path="res://engine/character/unit_core/frame.gd" id="1_frame"]
[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="2_kit"]
[ext_resource type="Texture2D" uid="uid://che1iapn1u0c1" path="res://assets/frames/shared/blank.png" id="3_sprite"]
[ext_resource type="Resource" uid="uid://d0o7enanuy6q2" path="res://content/gear/shared/statblock_zero.tres" id="4_statblock"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/deployable/mt_decimate_terrain.tres" id="5_zone"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_leoleth/cp_hydraulic_excess/deployable/mt_decimate_expiry.tres" id="6_expiry"]

[resource]
script = ExtResource("1_frame")
; VANILLA'S BLANK, the same sprite dep_apocalypse_difficult.tres wears. The crater is DRAWN by the
; terrain zone's fxe, one instance per voxel, not by a token sprite - so this needs no art and SP5
; owes it none. (The Vauban's Maar has its own .svg because the author drew one; if the author draws
; one for this crater it goes here.)
sprites = Array[Texture2D]([ExtResource("3_sprite")])
; The zone first, then its own expiry.
traits = Array[ExtResource("2_kit")]([ExtResource("5_zone"), ExtResource("6_expiry")])
; statblock_zero: size 1, half-size. Shared with the Maar and the Magnetic Field Projector's
; deployable.
stat = ExtResource("4_statblock")
; MARKER (Frame.ENTITY == { CHARACTER, OBJECT, MARKER }, frame.gd:58-63), so it is not a combatant: it
; takes no attacks, blocks no line of sight, and PassiveAura.update_unit skips it outright
; (passive_aura.gd:25) - which is what keeps Bulwark's aura (Task 11) off it.
entity_type = 2
is_obstruction = false
;
; is_deactivated_on_owner_death IS DELIBERATELY NOT WRITTEN, and that is the ONE LINE where this
; differs from the Maar. The export defaults TRUE (frame.gd:65) and
; EventService.remove_unit_from_game queues event_unit_die on every owned MARKER that has it
; (event_service.gd:56-63) - so the crater dies with the Leoleth, which is ruling 8. dep_maar.tres
; writes `false` for the opposite reason and says so at length; do not copy that line here.

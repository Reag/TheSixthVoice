[ext_resource type="PackedScene" path="res://unpacked/Reag-TheSixthVoice/res/content/fx_endless/gear/fxe_reag_shattered_ground.tscn" id="6_fxe"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/mt_decimate_terrain.svg" id="7_icon"]

; BLAST 1 (Lancer.AOE_TYPE.BLAST == 1, lancer.gd:96-100), centred on the crater itself - the Maar's
; own shape. BLAST rather than BURST for the Maar's reason: BURST covers the origin's whole FOOTPRINT
; plus the radius, BLAST covers the anchor plus or minus it, and a crater has no footprint. Centred
; on a size-1 unit's tile the two are the same nine tiles, which is the card's Burst 1 exactly
; (ruling 8).
[sub_resource type="Resource" id="Resource_blast1"]
script = ExtResource("5_rangepattern")
pattern = 1
value = 1

[sub_resource type="Resource" id="Resource_difficult"]
script = ExtResource("4_terraindata")
difficult_terrain = true

; A PLAIN PassiveTerrainZone, not SP1's gated one: a crater has nothing to gate on. It exists only
; while its unit does, which IS its lifetime.
[sub_resource type="Resource" id="Resource_zone"]
script = ExtResource("3_terrainzone")
terrain_data = SubResource("Resource_difficult")
range_pattern = SubResource("Resource_blast1")
height = 1
; The mod's EXISTING shared ground fx - the same scene mt_maar_terrain.tres and
; passive_grav_amped_field.tres already wear. PassiveTerrainZone.get_attached_fx draws one instance at
; every voxel the zone's own range_pattern covers, so this ships a drawn crater with NO new art.
fxe = ExtResource("6_fxe")

[resource]
script = ExtResource("1_kit")
passives = Array[ExtResource("2_passive")]([SubResource("Resource_zone")])
is_trait = true
; SP5: a jagged crater fissure. A MARKER's Kit icon is drawn on nothing today, but the icon guard
; checks every Kit unconditionally, so this still needs a real one (measured against the live guard,
; 2026-09-22; the Vauban's mt_maar_terrain.svg is the same shape). Shared with mt_decimate_expiry -
; the crater and its own expiry timer are one mechanic, not two pictures.
icon_override = ExtResource("7_icon")

[resource]
script = ExtResource("1_buff")
; Lancer.WEAPON_TYPE is { CQB, CANNON, MELEE, RIFLE, LAUNCHER, NEXUS } (lancer.gd:107), so MELEE is 2.
weapon_types_forbidden = Array[int]([2])
allow_basic = true
bonus_subtype = &"accuracy"
bonus_value = -2
to = &"attack_roll"
hide_from_player = true
; `until` is omitted: Lancer.UNTIL.MANUAL is its own zero (lancer.gd:46-47) and this is a permanent
; frame trait. HIDDEN_BUFFS_NEEDING_ICONS still needs a real icon (attack_roll.gd:189 draws
; buff_core.base.icon RAW into the roll breakdown) - SP5 reuses the Kit's own reticle glyph, since
; this chip IS the trait's mechanic and not a separate picture.
icon = ExtResource("2_icon")

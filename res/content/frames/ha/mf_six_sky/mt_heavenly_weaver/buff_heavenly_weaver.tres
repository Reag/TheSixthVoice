; HEAVENLY WEAVER's chip (rulings 8-10; the script's header has the seam). until 0 is Lancer.UNTIL.MANUAL
; - "the next successful attack" may be rounds away, and FINISH_DAMAGE would clear it after the first
; attack either way. VISIBLE, with its own name row: the only on-token sign the charge is live. SP3
; gives it the Heavenly Weaver family's texture.
[resource]
script = ExtResource("1_buff")
damage_dice = "1d6"
inherit_type_from_attack = true
require_hit = true
until = 0
to = &"bonus_damage_specific"
is_onetime = true

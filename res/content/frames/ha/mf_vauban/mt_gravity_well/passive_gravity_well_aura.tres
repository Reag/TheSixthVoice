script = ExtResource("1_aura")
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])
; "ADJACENT" = 1. UnitRelation.distance_between measures CLOSEST TILES, and passive_aura.gd:85 is
; where it is compared against this number. It is also the seam a third-party adjacency mod does NOT
; reach - House Guard overrides adjacent_characters() and nothing else, so no aura in the game sees
; its widening, ours or vanilla's. Ruled 2026-09-18 and pinned by spec/test_compat.gd.
aura_range = 1
; Not hostiles. applies_to_self and applies_to_allies are left at their TRUE defaults (the card's two
; sentences), as are applies_only_to_characters and starts_active - the card has no switch, so unlike
; the Myconid's Fungal Network auras this one is on from the first tracking pass.
; applies_only_to_characters is NOT sufficient for "mechs": a drone is a character, which is why this
; passive carries a script.
applies_to_enemies = false

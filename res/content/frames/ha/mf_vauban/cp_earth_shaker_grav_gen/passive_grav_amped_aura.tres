[gd_resource type="Resource" script_class="PassiveAura" format=3]

[ext_resource type="Script" uid="uid://dw0igjjw1k5s3" path="res://engine/character/gear_passive/passive_aura.gd" id="1_aura"]
[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="2_buff"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_vauban/cp_earth_shaker_grav_gen/buff_grav_amped_saves.tres" id="3_chip"]

[resource]
script = ExtResource("1_aura")
; NO SCRIPT, unlike the Gravity Well aura beside it: every decision this aura makes is one of
; PassiveAura's own exports.
buffs = Array[ExtResource("2_buff")]([ExtResource("3_chip")])
; 99 IS "NO RANGE", NOT A RANGE. The card puts no range on this clause - a save the Vauban forces can
; only come from something already in its reach - so the chip has to reach every hostile on the board.
; UnitRelation.distance_between is Chebyshev, so 99 covers any map this game ships. The Hornet's
; System Spike is the vanilla precedent for a board-wide hostile aura and it goes the other way,
; overriding is_within_range to use sensor range (passive_system_spike_hornet.gd); a script was not
; written here because there is no sensor limit to express, and design §2.2 chose the number.
aura_range = 99
applies_to_self = false
applies_to_allies = false
applies_to_enemies = true
applies_only_to_characters = true
; DARK UNTIL THE PROTOCOL. GearCore.set_aura_active(true, unit, event) is what wakes it, and it runs
; the tracking pass itself so everyone already on the board is chipped at the moment of the press
; (gear_core.gd:297-300).
starts_active = false

[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_vauban/cp_earth_shaker_grav_gen/deployable/mt_maar_terrain.tres" id="5_zone"]

[resource]
script = ExtResource("1_frame")
; BLANK UNTIL SP3. The author asked for the Maar to carry its own art rather than read as a generic
; crater (design ruling 8), and SP3 supplies it along with the shared per-tile ground fx both this
; zone and the Grav-Amped field will draw (ruling 13). vanilla's blank.png is what
; dep_apocalypse_difficult.tres and dep_magnetic_field_projector.tres both wear in the meantime.
sprites = Array[Texture2D]([ExtResource("3_blank")])
traits = Array[ExtResource("2_kit")]([ExtResource("5_zone")])
; statblock_zero: size 1, half-size. Shared with the Magnetic Field Projector's deployable.
stat = ExtResource("4_statblock")
; MARKER (Frame.ENTITY == {CHARACTER, OBJECT, MARKER}, frame.gd:58-63), so it is not a combatant: it
; takes no attacks, blocks no line of sight, and PassiveAura.update_unit skips it outright
; (passive_aura.gd:25). An OBJECT would be shootable cover, which a hole in the ground is not.
entity_type = 2
is_obstruction = false
;
; *** THE ONE LINE THE WHOLE CARD DEPENDS ON. *** This export DEFAULTS TO TRUE (frame.gd:65), and
; EventService.remove_unit_from_game walks every unit owned by a dying one and queues event_unit_die
; on each MARKER that has it set (event_service.gd:56-63). Terrain.lay records this crater's owner
; through UnitAction.set_deployable_owner, so with the default the crater would die with the Vauban
; and "for the rest of the scene" would quietly become "until you die". Measured at SP1 Task 2,
; mutation 4. dep_apocalypse_difficult.tres gets away with omitting it only because the Rail never
; calls set_deployable_owner at all.
; Deleting this line is MUTATION T4-M1 and reddens BOTH test_the_crater_survives_the_vaubans_death
; and test_the_card_carries_the_persists_tag: ActionSystemDeploy.get_glossary_tags appends
; lancer.term.persists exactly when this is false (action_system_deploy.gd:53-60), so the export is
; player-facing as well as load-bearing.
is_deactivated_on_owner_death = false

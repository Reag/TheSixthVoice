[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_vauban/cp_earth_shaker_grav_gen/passive_grav_amped_field.tres" id="5_field"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_vauban/cp_earth_shaker_grav_gen/passive_grav_amped_aura.tres" id="6_aura"]

[resource]
script = ExtResource("1_kit")
; EARTH SHAKER GRAV-GEN, the Vauban's core system. One protocol that lights three things, one quick
; action that lays a crater, and the deployable that crater is.
;
; GROWS ACROSS FOUR TASKS, in this order: the protocol and the field (Task 1), the save aura and its
; buff (Task 2), the 3 AP reaction (Task 3), MASTICATION OF THE MAAR (Task 4). Each appends; nothing
; reorders. The arrays below are therefore in build order, which is also the order the gear bar shows
; the two pressables in (gear_bar.gd walks the actions array).
;
; WHAT PUTS THIS KIT IN LoadoutCore.auras: the PassiveAura added in Task 2. regenerate_caches
; (loadout_core.gd:298-301) walks every piece of gear and appends any whose Kit has_passive_type
; (PassiveAura); that list is what PassiveAura.update_unit iterates (:31). A Kit without one is
; invisible to the aura system however its passives are shaped - which is why Task 2's aura is not
; optional scaffolding but the thing that makes set_aura_active mean anything here.
;
; THE TERRAIN ZONE DOES NOT GO THROUGH THAT LIST AND NEEDS NOTHING TO REGISTER IT.
; MapState.add_dynamic_terrain_and_zones_from_unit walks every gear's every PassiveTerrainZone
; unconditionally (map_state.gd:427-432), which is exactly why the field has to gate itself.
actions = Array[ExtResource("2_action")]([ExtResource("4_protocol")])
passives = Array[ExtResource("3_passive")]([ExtResource("5_field"), ExtResource("6_aura")])
; A frame trait, not equippable gear: it costs no SP and cannot be unequipped. cp_quietus_machines,
; cp_siege_engine and cp_broadside are the same.
is_trait = true
;
; NO INTEGRATED WEAPON. The Vauban's sheet lists none, so unlike the Subutai and the Myconid there is
; no mw_ Kit beside this one and no integrated-weapon box to title. The 2026-09-17 directive
; (memory integrated-weapon-two-kit-rule) has nothing to bite on here.

; PROTOCOL (Lancer.ACTION.PROTOCOL == 4, lancer.gd:27) and it spends the frame's one core power.
action_type = 4
consumes_cp = true
; A protocol and a pressable on one Kit need a usage_group EACH (unit_action.gd:167-168). Task 4 adds
; the second pressable, so this is load-bearing, not precautionary.
usage_group = &"grav_amped_interference"
; The same core-power flourish the Myconid's Fungal Network wears; there is nothing frame-specific
; about it and SP3 does not replace it.
fxg_use = ExtResource("2_superfx")
emit_text_popcorn_on_use = true

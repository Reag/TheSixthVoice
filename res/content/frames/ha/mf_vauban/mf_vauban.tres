default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
traits = Array[ExtResource("8_kit")]([ExtResource("10_breach"), ExtResource("11_sap"), ExtResource("12_well"), ExtResource("13_core")])
mount_types = Array[ExtResource("5_mounttype")]([ExtResource("6_mountflex"), ExtResource("7_mountheavy")])
stat = SubResource("Resource_statblock")
role_primary = 3

[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]

[resource]
script = ExtResource("1_buff")
; HIDDEN. It is bookkeeping - "a character that succeeds this save is unaffected by Sap until the end
; of their next turn" - and a chip on the unit saying so would read as a debuff the card does not
; have. Deliberately absent from test_content_integrity's VISIBLE_BUFFS.
hide_from_player = true
; END_OF_NEXT_TURN, the same lifetime as the Slowed a failure applies (ruling 4).
until = 1

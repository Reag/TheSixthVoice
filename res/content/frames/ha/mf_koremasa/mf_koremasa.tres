; DERIVED FROM THE SPRITE ART (the Gloire's and the Grutte Pier's method). Measured 2026-09-25 with the
; shader-literal test palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/(0,v,0)/(0,0,v)/(0,v,v)):
; mf_koremasa.png (80x80, the size-1 token canvas a size-1/2 frame uses, as the Fitzgerald's does;
; 1,314 opaque pixels) has ZERO channel-encoded pixels, so this scheme is INERT on this sprite - it
; cannot repaint the token (memory frame-sprites-not-channel-encoded). The art is painted (1,088
; distinct colours; the top single colour is 18px), so an exact census fragments; base_0..2 are the
; centroids of a 3-means (seeded by luminance terciles, converged in 4 passes) over the 1,306 opaque
; pixels brighter than the outline (max channel >= 30): the grey-violet plate (98,95,107 - 591px), the
; pale cyan plasma (151,183,192 - 367px) and the dark violet shadow (59,51,61 - 348px), most-used
; first per the Iskander's slot convention. palette_2 keeps the Iskander's HA ramp, as the Leoleth's
; does.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
palette_2 = ExtResource("4_toneramp")
base_0 = Color(0.38431373, 0.37254902, 0.41960784, 1)
base_1 = Color(0.59215686, 0.71764706, 0.75294118, 1)
base_2 = Color(0.23137255, 0.2, 0.23921569, 1)

; The sheet (specs/sixth-voice/16-koremasa.md), design ruling 33. SIZE 1/2 IS `size = 1` PLUS
; `is_size_half = true` - the Fitzgerald's form (mf_fitzgerald.tres:25-26); UnitCore.is_size_half()
; reads the flag (unit_core.gd:391). armor = 0 is written though it is the default, so a reader need
; not know the export's default to know the card.
[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 1
is_size_half = true
structure = 4
stress = 4
health = 6
armor = 0
evasion = 10
edef = 8
speed = 4
heat = 8
save_target = 10
sensor_range = 5
tech_attack = 1
repairs = 4
systems_points = 6
reactions = 1
activations = 1

[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
; SHEET ORDER: Plasma Shimmer, Exploit Weakness, Entrap. The core system,
; cp_overdrive_exploitation_sequences, is appended at SP2 - an ext_resource pointing at a file that does
; not exist yet would fail this whole resource to parse, taking the frame out of ContentLibrary silently.
traits = Array[ExtResource("8_kit")]([ExtResource("10_shimmer"), ExtResource("11_exploit"), ExtResource("12_entrap")])
; Flex, Main/Aux - the sheet's order.
mount_types = Array[ExtResource("5_mounttype")]([ExtResource("6_mountflex"), ExtResource("7_mountmainaux")])
stat = SubResource("Resource_statblock")
; STRIKER (1) then CONTROLLER (3) - Lancer.SQUAD_ROLE, lancer.gd:181.
role_primary = 1
role_secondary = 3

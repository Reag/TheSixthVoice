; SUPPORTING FIRE, the core passive (rulings 4-5; the script's header has the seam). NEW_TURN POST,
; point-free, its own usage group.
[resource]
script = ExtResource("1_action")
ally_buff = ExtResource("2_ally")
cost_buff = ExtResource("3_cost")
usage_group = &"supporting_fire"
triggers_on = Array[StringName]([&"new_turn"])
trigger_timing = 1
consumes_rxn = false
icon_override = ExtResource("4_icon")

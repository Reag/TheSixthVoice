; DERIVED FROM THE SPRITE ART (the Gloire's method). Measured 2026-09-25 with the shader-literal test
; palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/(0,v,0)/(0,0,v)/(0,v,v)): mf_grutte_pier.png
; (80x80, the size-1 token size; 2,396 opaque pixels) has 7 channel-encoded pixels (0.3%) -
; anti-aliasing noise, not encoding - so this scheme is INERT on this sprite like the Gloire's. The
; art is anti-aliased (2,110 distinct colours), so base_0..2 are the centroids of a 3-means over the
; 2,338 pixels brighter than the outline (max channel >= 30): the teal-grey plate (84,97,97 - 888px),
; the dark umber (65,58,56 - 824px) and the pale steel highlight (121,142,144 - 626px), most-used
; first per the Iskander's slot convention.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
base_0 = Color(0.3294118, 0.3803922, 0.3803922, 1)
base_1 = Color(0.254902, 0.227451, 0.2196078, 1)
base_2 = Color(0.4745098, 0.5568627, 0.5647059, 1)

; The sheet (specs/sixth-voice/15-grutte-pier.md): size 1 - the Drake it replaces is size 2.
[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 1
structure = 4
stress = 4
health = 8
armor = 2
evasion = 8
edef = 6
speed = 3
heat = 4
save_target = 10
sensor_range = 5
tech_attack = -1
repairs = 6
systems_points = 5
reactions = 1
activations = 1

; SHEET ORDER: Panoply Coat, Bulwark, then the core system (SP2, design ruling 18).
[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("8_sprite")])
traits = Array[ExtResource("7_kit")]([ExtResource("9_panoply"), ExtResource("10_bulwark")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountmain"), ExtResource("6_mountheavy")])
stat = SubResource("Resource_statblock")
role_primary = 2
role_secondary = 1

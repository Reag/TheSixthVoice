script = ExtResource("4_kit")
actions = Array[ExtResource("7_action")]([ExtResource("8_origin")])
passives = Array[ExtResource("1_passive")]([SubResource("Resource_applicator")])
is_trait = true
icon_override = ExtResource("6_icon")

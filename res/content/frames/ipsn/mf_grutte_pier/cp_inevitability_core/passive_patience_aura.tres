[ext_resource type="Script" uid="uid://cqrqkdgcf8mti" path="res://engine/character/buff/buff.gd" id="1_buff"]
[ext_resource type="Script" uid="uid://dw0igjjw1k5s3" path="res://engine/character/gear_passive/passive_aura.gd" id="2_aura"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_grutte_pier/cp_inevitability_core/buff_patience_reduce.tres" id="3_reduce"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_grutte_pier/cp_inevitability_core/buff_patience_in_all_things.tres" id="4_patience"]

; PATIENCE IN ALL THINGS' reach (design ruling 16): the reduction buff on every hostile character, the
; whole map over, while the Pier holds the protocol's chip. Line of sight is NOT the aura's job: an
; aura re-checks only on movement and buff changes (unit_tile.gd:15-24), so an aura-level LOS gate
; goes stale when sight changes without anyone moving. buff_patience_reduce checks can_see at the roll.
[resource]
script = ExtResource("2_aura")
buffs = Array[ExtResource("1_buff")]([ExtResource("3_reduce")])
aura_range = 99
applies_to_self = false
applies_to_allies = false
applies_to_enemies = true
applies_only_to_characters = true
applies_regardless_of_elevation = true
requires_buff = ExtResource("4_patience")

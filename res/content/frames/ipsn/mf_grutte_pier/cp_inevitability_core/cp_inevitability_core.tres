[resource]
script = ExtResource("1_kit")
; THE INEVITABILITY CORE, the Grutte Pier's core system (SP2, design rulings 6-17).
;
; THE cp_ PREFIX IS WHAT ROUTES IT TO THE CORE SYSTEM BOX (resgrp_kits' **/cp_*.tres glob).
;
; THE COUNTER IS passives[0] ON PURPOSE: the gear bar draws a Kit's die-counter badge only from its
; first passive, on a Kit with a visible non-reaction action (linked_gear_bar_button.gd:49-56) - the
; protocol is that action.
;
; THE PROTOCOL IS actions[0] ON PURPOSE: get_solo_action() is kit.actions[0] (gear_core.gd:337-339).
; Every other action is a hidden reaction, never on the gear bar or the card.
actions = Array[ExtResource("2_action")]([ExtResource("6_patience"), ExtResource("11_spend"), ExtResource("7_tally"), ExtResource("8_gain"), ExtResource("9_lapse"), ExtResource("10_charge")])
; passives[1] hangs the +Range variant buff (ruling 10) on the Pier for good; the buff offers its row
; only while it applies (buff_zwarte_hoop_range.offered).
passives = Array[ExtResource("3_passive")]([ExtResource("4_charges"), SubResource("Resource_range_applicator"), ExtResource("5_aura")])
; A frame trait, not equippable gear: no SP, cannot be unequipped.
is_trait = true
icon_override = ExtResource("15_icon")

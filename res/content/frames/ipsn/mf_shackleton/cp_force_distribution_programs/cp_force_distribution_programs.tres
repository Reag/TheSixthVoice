[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="1_kit"]
[ext_resource type="Script" uid="uid://b8unc74nyhjr0" path="res://engine/character/gear_action/action.gd" id="2_action"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_shackleton/cp_force_distribution_programs/action_unfathomable_weight.tres" id="3_weight"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_shackleton/cp_force_distribution_programs/action_unfathomable_weight_collide.tres" id="4_collide"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_shackleton/cp_force_distribution_programs/action_calamitous_impact.tres" id="5_impact"]

[resource]
script = ExtResource("1_kit")
; FORCE DISTRIBUTION PROGRAMS, the Shackleton's core system (SP2, design rulings 8-15).
;
; THE cp_ PREFIX IS WHAT ROUTES IT TO THE CORE SYSTEM BOX (resgrp_kits' **/cp_*.tres glob), not the
; folder and not the script class.
;
; SHEET ORDER: the passive Unfathomable Weight, then the active Calamitous Impact. The collision
; reaction between them is Unfathomable Weight's other half and never reaches the gear bar (a
; reaction) or the card (its localization_key_override).
actions = Array[ExtResource("2_action")]([ExtResource("3_weight"), ExtResource("4_collide"), ExtResource("5_impact")])
; A frame trait, not equippable gear: no SP, cannot be unequipped.
is_trait = true
;
; NO INTEGRATED WEAPON and NO .effect ROW: the LCP gives this core a passive ACTION and an active,
; and their own rows carry the text. The .flavor row is the LCP's description, verbatim. Icon: SP3.

; SIZE 2, HALF-SIZE, INLINE - dep_apocalypse_difficult.tres:2-4's statblock. No vanilla statblock_*
; file is size 2. The size is what makes the zone's BURST 2 the 6x6 (mt_shackleton_crater.tres).
[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("3_statblock")
size = 2
is_size_half = true

[resource]
script = ExtResource("1_frame")
; Vanilla's blank until SP3 draws the crater (dep_apocalypse_difficult wears the same).
sprites = Array[Texture2D]([ExtResource("4_sprite")])
traits = Array[ExtResource("2_kit")]([ExtResource("5_zone")])
stat = SubResource("Resource_statblock")
; MARKER, not an obstruction: ground, not a combatant and not cover (dep_maar.tres's reasoning).
entity_type = 2
is_obstruction = false
; *** "FOR THE REST OF THE SCENE." *** The export defaults TRUE (frame.gd:65), and Terrain.lay records
; the Shackleton as owner, so without this line the crater would die with it
; (event_service.gd:56-63). It is also what puts "Persists" on Calamitous Impact's card.
is_deactivated_on_owner_death = false

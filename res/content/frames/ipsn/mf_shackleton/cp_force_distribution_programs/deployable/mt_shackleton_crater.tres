[gd_resource type="Resource" script_class="Kit" format=3]

[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="1_kit"]
[ext_resource type="Script" uid="uid://n33no7rw7y82" path="res://engine/character/gear_passive/passive.gd" id="2_passive"]
[ext_resource type="Script" uid="uid://cdg8upk76j000" path="res://engine/character/gear_passive/passive_terrain_zone.gd" id="3_terrainzone"]
[ext_resource type="Script" uid="uid://bhirgicgi66th" path="res://engine/gamemaster/map/terrain/terrain_data.gd" id="4_terraindata"]
[ext_resource type="Script" uid="uid://c0yv6pnw2be6l" path="res://engine/character/gear_action/resources/range_pattern.gd" id="5_rangepattern"]
[ext_resource type="PackedScene" path="res://unpacked/Reag-TheSixthVoice/res/content/fx_endless/gear/fxe_reag_shattered_ground.tscn" id="6_fxe"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/icons/action_calamitous_impact.svg" id="7_icon"]

; BURST 2 (Lancer.AOE_TYPE.BURST == 4), design ruling 14. From a SIZE-2 origin a burst covers the
; whole footprint plus the radius (AoeCalculator.burst iterates range(-radius, size+radius)), so this
; crater - laid at the Shackleton's anchor with the Shackleton's own footprint - covers exactly the
; 6x6 that Calamitous Impact's Burst 2 did. BLAST 2 (the Apocalypse Rail's pattern 1) is a 5x5 around
; one tile, a row and a column short. The Maar is a BLAST 1 for the opposite reason: a size-1 crater
; has no footprint worth projecting from.
[sub_resource type="Resource" id="Resource_burst2"]
script = ExtResource("5_rangepattern")
pattern = 4
value = 2

[sub_resource type="Resource" id="Resource_difficult"]
script = ExtResource("4_terraindata")
difficult_terrain = true

; A PLAIN PassiveTerrainZone: the crater exists only while its unit does, which IS its lifetime.
[sub_resource type="Resource" id="Resource_zone"]
script = ExtResource("3_terrainzone")
terrain_data = SubResource("Resource_difficult")
range_pattern = SubResource("Resource_burst2")
height = 1
; The shared per-tile ground fx the Maar and the Grav-Amped field draw, so the difficult ground is
; visible from the day it lands. SP3 may give the crater its own.
fxe = ExtResource("6_fxe")

[resource]
script = ExtResource("1_kit")
; The crater's only content: the ground it makes difficult. No mt_die_on_owner_death - it outlives the
; Shackleton ("for the rest of the scene"). Shares Calamitous Impact's texture (icon directive, "a
; visible chip joins its family").
passives = Array[ExtResource("2_passive")]([SubResource("Resource_zone")])
is_trait = true
icon_override = ExtResource("7_icon")

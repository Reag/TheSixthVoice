; DERIVED FROM THE SPRITE ART (the Vauban's SP5 ruling, re-run as the Naga's was). Measured
; 2026-09-24 with the shader-literal test palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/
; (0,v,0)/(0,0,v)/(0,v,v) for v in palette_index_r.png's seven red values): mf_shackleton.png
; (160x160, 12,961 opaque pixels) has 2 channel-encoded pixels - anti-aliasing noise, not encoding -
; so this scheme is INERT on this sprite like the Naga's, Vauban's, Sluagh's and Primrose's. The
; art is anti-aliased, so an exact census fragments (the top colour is 249px of 12,961); base_0..2
; are the means of the three largest non-black colour families instead (48-wide RGB buckets): the
; crimson plate (150,30,44; the three red buckets together 4,323px), the grey-mauve shadow
; (79,61,72 - 1,637px) and the pale mauve highlight (201,148,169, the top single light colour),
; most-used first per the Iskander's slot convention.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
base_0 = Color(0.5882353, 0.11764706, 0.17254902, 1)
base_1 = Color(0.30980393, 0.23921569, 0.28235295, 1)
base_2 = Color(0.7882353, 0.5803922, 0.6627451, 1)

[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 2
structure = 4
stress = 4
health = 8
armor = 1
evasion = 8
edef = 6
speed = 5
heat = 6
save_target = 11
sensor_range = 8
tech_attack = -2
repairs = 5
systems_points = 6
reactions = 1
activations = 1

; SHEET ORDER. The core system (cp_force_distribution_programs) lands at SP2 - an ext_resource to a
; file that does not exist yet would fail the whole frame out of ContentLibrary.
[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("8_sprite")])
traits = Array[ExtResource("7_kit")]([ExtResource("9_rerouting"), ExtResource("10_hydraulics"), ExtResource("11_weakcomputer")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountflex"), ExtResource("5_mountflex"), ExtResource("6_mountmainaux")])
stat = SubResource("Resource_statblock")
role_primary = 3

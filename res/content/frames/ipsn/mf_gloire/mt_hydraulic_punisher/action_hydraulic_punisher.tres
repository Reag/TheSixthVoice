[gd_resource type="Resource" script_class="ActionReaction" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_gloire/mt_hydraulic_punisher/action_hydraulic_punisher.gd" id="1_punisher"]

[resource]
script = ExtResource("1_punisher")
; The Vlad's Dismemberment shape (action_dismemberment_shred.tres): statuses_changed at PRE is a status
; being APPLIED (reaction_bus.gd:31; TIMING.PRE = 0).
triggers_on = Array[StringName]([&"statuses_changed"])
trigger_timing = 0
; Not a reaction point: "1/round" is the script's own hard limit, counted on this group.
consumes_rxn = false
usage_group = &"hydraulic_punisher"
; THE LOG SAYS "Hydraulic Punisher" and the Kit card does not list this reaction: Translate.action
; reads gear.<override>.<property> (translate.gd:23-24), and a non-empty override is also what makes
; Action.show_in_tooltip answer false (action.gd:348).
localization_key_override = "mt_hydraulic_punisher"

[resource]
script = ExtResource("1_kit")
; RETALIATION PROTOCOL AMPLIFICATION, the Gloire's core system (SP2, design rulings 7-13, 15).
;
; THE cp_ PREFIX IS WHAT ROUTES IT TO THE CORE SYSTEM BOX (resgrp_kits' **/cp_*.tres glob), not the
; folder and not the script class.
;
; SHEET ORDER: the passive Rapid Rushdown, then the active RPA Pullback. The collision reaction after
; them is RPA Pullback's other half and never reaches the gear bar (a reaction) or the card (its
; localization_key_override). RAPID RUSHDOWN IS actions[0] ON PURPOSE: get_solo_action() is
; kit.actions[0] (gear_core.gd:337-339), and the hidden armour-reduction buff's battle-log name falls
; through to that row (buff_rapid_rushdown_armor_reduction.tres's note).
actions = Array[ExtResource("2_action")]([ExtResource("3_rushdown"), ExtResource("4_pullback"), ExtResource("5_collide")])
; A frame trait, not equippable gear: no SP, cannot be unequipped.
is_trait = true
icon_override = ExtResource("6_icon")
;
; NO INTEGRATED WEAPON and NO .effect ROW: the LCP gives this core a passive ACTION and an active,
; and their own rows carry the text. The .flavor row is the LCP's description, verbatim. SP3: the
; Kit's own bare glyph (a third, distinct family) plus exactly two pressable families - Rapid
; Rushdown with its armour chip, RPA Pullback with its chip and its hidden pull and collision pieces;
; design section 3.

[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ipsn/mf_gloire/mt_extended_zone_control/mt_extended_zone_control.tres" id="11_zonecontrol"]

; DERIVED FROM THE SPRITE ART (the Vauban's SP5 ruling, re-run as the Shackleton's was). Measured
; 2026-09-24 with the shader-literal test palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/
; (0,v,0)/(0,0,v)/(0,v,v)): mf_gloire.png (160x160, 12,814 opaque pixels) has 52 channel-encoded
; pixels (0.4%) - anti-aliasing noise, not encoding - so this scheme is INERT on this sprite like the
; Shackleton's, Naga's, Vauban's, Sluagh's and Primrose's. The art is anti-aliased steel in one hue
; (3,369 distinct colours; the top single colour is 135px of 12,814), so an exact census fragments;
; base_0..2 are the centroids of a 3-means over the 11,458 pixels brighter than the outline (max
; channel >= 30): the dark slate plate (50,56,59 - 5,870px), the mid steel (87,97,101 - 3,808px) and
; the light steel highlight (125,140,145 - 1,780px), most-used first per the Iskander's slot
; convention.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
base_0 = Color(0.1960784, 0.2196078, 0.2313725, 1)
base_1 = Color(0.3411765, 0.3803922, 0.3960784, 1)
base_2 = Color(0.4901961, 0.5490196, 0.5686275, 1)

[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 2
structure = 4
stress = 4
health = 8
armor = 2
evasion = 6
edef = 7
speed = 3
heat = 5
save_target = 10
sensor_range = 8
tech_attack = -1
repairs = 6
systems_points = 6
reactions = 1
activations = 1

; SHEET ORDER: Guardian, Hydraulic Punisher, Extended Zone Control, then the core system (appended
; at SP2). Design ruling 14 enumerates the same four; the sheet fixes the order, as every frame
; here (mf_shackleton.tres) follows it.
[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("8_sprite")])
traits = Array[ExtResource("7_kit")]([ExtResource("9_guardian"), ExtResource("10_punisher"), ExtResource("11_zonecontrol")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountmain"), ExtResource("5_mountmain"), ExtResource("6_mountheavy")])
stat = SubResource("Resource_statblock")
role_primary = 1
role_secondary = 2

sprites = Array[Texture2D]([ExtResource("9_sprite"), ExtResource("13_smilerose")])
traits = Array[ExtResource("8_kit")]([ExtResource("10_mwr"), ExtResource("11_caress"), ExtResource("12_core")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountmain"), ExtResource("5_mountmain"), ExtResource("6_mountheavy")])
stat = SubResource("Resource_statblock")
role_primary = 1

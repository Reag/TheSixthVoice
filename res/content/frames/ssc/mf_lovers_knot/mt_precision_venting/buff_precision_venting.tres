; "A Ranged weapon" is every non-MELEE ActionAttackWeapon (UnitAction.is_ranged_weapon,
; unit_action.gd:555-559), so MELEE (2) is FORBIDDEN rather than the rest listed: Blast, Burst, Cone
; and Line are all ranged weapons (ruling 4). allow_basic stays false, BuffWeaponType's default.
[resource]
script = ExtResource("3_buff")
effects = Array[ExtResource("1_onhiteffect")]([ExtResource("2_onhit")])

[resource]
script = ExtResource("1_buff")
; FORM OF THE MYRIAD's chip (design 3, rulings 18-20). The ability is two readers of its id -
; buff_gemini_charge.gd chains up to 4 legs at the weapon's full reach while it is held, and Precision
; Venting stands its round gate down and leaves the round uncounted. Both read the id through
; UnitCondition.has_buff, which keys on this file's basename, so renaming it silently kills both.
; Its script (buff_form_of_the_myriad.gd) has one hook since Pass E: when the chip goes, a Gemini round
; the Myriad restored and its turn left unused is spent again (ruling 19).
;
; VISIBLE, and its own rows: the only on-token sign that the chain is live and when it ends.
; until 2 is Lancer.UNTIL.END_OF_THIS_TURN - "until the end of your turn". SP4: wears its own texture,
; the Myriad family's bolder chip variant.
until = 2
icon = ExtResource("2_icon")

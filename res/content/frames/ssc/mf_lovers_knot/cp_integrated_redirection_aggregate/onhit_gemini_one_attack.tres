; The Knot's one-time roll buffs, set aside per target and consumed once after the attack (task 11c).
; apply_on is ON_RESOLUTION (4) so the base class never applies statuses or buffs of its own: the work
; is all in the script's on_attack and on_resolution overrides.
[resource]
script = ExtResource("1_onhit")
apply_on = 4

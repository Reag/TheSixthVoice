; THE COLOUR SCHEME IS A 3-MEANS OVER THE AUTHOR'S ART (the Koremasa's method, 2026-09-26). The 80x80
; sprite has 1,413 opaque pixels and NONE is channel-encoded, so the player's colour picker cannot
; repaint this token and these three are inert until encoded art lands (memory
; frame-sprites-not-channel-encoded). Clusters, luminance-tertile seeded: dusky plum plate
; (97,73,107) x551, deep indigo shadow (40,34,60) x463, pale rose highlight (186,155,174) x399. The
; plate is base_0, the highlight the accent in base_1, the shadow base_2.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
palette_2 = ExtResource("4_toneramp")
base_0 = Color(0.38039216, 0.28627452, 0.41960785, 1)
base_1 = Color(0.7294118, 0.60784316, 0.68235296, 1)
base_2 = Color(0.15686275, 0.13333334, 0.23529412, 1)

; The sheet's table (specs/sixth-voice/18-lovers-knot.md). NOT the Death's Head's numbers (design
; ruling 2): Sensors 15 (DH 20), Repair cap 4 (DH 2). armor and tech_attack are 0, the exports'
; defaults, written out anyway so the sheet reads off the file.
[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 1
structure = 4
stress = 4
health = 8
armor = 0
evasion = 10
edef = 8
speed = 5
heat = 6
save_target = 10
sensor_range = 15
tech_attack = 0
repairs = 4
systems_points = 6
reactions = 1
activations = 1

[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
; SHEET ORDER: Precision Venting, Fractured Silhouette, Fragile (vanilla's, by path - design ruling
; 22), then the core system (empty at SP1; SP2 and SP3 fill it).
traits = Array[ExtResource("8_kit")]([ExtResource("10_venting"), ExtResource("11_silhouette"), ExtResource("12_fragile"), ExtResource("13_core")])
; Main, Heavy - the sheet's order. The Death's Head has Heavy + Main/Aux (ruling 2).
mount_types = Array[ExtResource("5_mounttype")]([ExtResource("6_mountmain"), ExtResource("7_mountheavy")])
stat = SubResource("Resource_statblock")
; ARTILLERY (4) alone - Lancer.SQUAD_ROLE, lancer.gd:181.
role_primary = 4

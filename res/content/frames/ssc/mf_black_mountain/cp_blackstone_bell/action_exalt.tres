[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ssc/mf_black_mountain/cp_blackstone_bell/action_exalt.gd" id="1_action"]

; EXALT, Bringer of Glory's reaction (ruling 11; the script's header has the gate and the order). DAMAGE
; POST (trigger_timing 1). consumes_rxn true: a REAL reaction (author) - it needs and spends the reaction
; point; the script's hard limit is the card's 3/round. recheck_trigger_before_execution stays false ON
; PURPOSE: the structure arithmetic is only right when the gate is asked at queue time. Its own
; usage_group: the Kit also carries Fell the Mighty and the Efficient refund. SP3: the Kit's glyph (Bringer
; of Glory / Exalt is one family). PROMPTS (author ruling, close): taking a reaction is the player's
; choice, so activate() asks CommonActionUtil.confirm_use before spending; no separate ai_confirms_use
; override, so an AI Black Mountain still accepts automatically (Action's own default).
[resource]
script = ExtResource("1_action")
usage_group = &"action_exalt"
triggers_on = Array[StringName]([&"damage"])
trigger_timing = 1
consumes_rxn = true

[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ssc/mf_black_mountain/mt_an_end_to_all_things/buff_an_end_to_all_things_bonus.gd" id="1_bonus"]

; AN END TO ALL THINGS' +3 (ruling 7; the script's header has the lifetime argument). "3", flat: rolls
; nothing. NO `until` - is_onetime alone, consumed by the roll that read it
; (event_unit_attack_declared.gd:296); FINISH_DAMAGE is the one value that must not be set (Eyes of
; Night's measurement). HIDDEN, and named in the battle log through gear.buff_an_end_to_all_things_bonus.name.
; In NEITHER icon table: it lives for the width of one damage roll. inherit_type_from_attack and
; require_hit as the Heavenly Weaver chip spells them.
;
; multiple_copies_can_stack = true (frame close finding I-1, Important): without it,
; apply_buff_alt's same-source replacement (unit_condition.gd:741-747) matches on compcon_id +
; from_gear + to + until ALONE - it is blind to the DEFENDER_KEY state the .gd's check_if_passive_applies
; reads - so a SECOND offer on one attack (2/round permits it, e.g. a Blast hitting two hostiles)
; silently replaced the FIRST defender's +3 instead of coexisting beside it. Safe to stack: each copy
; is one-time and scoped to its own defender, so nothing can double-dip once it is consumed.
[resource]
script = ExtResource("1_bonus")
to = &"bonus_damage_specific"
damage_dice = "3"
inherit_type_from_attack = true
require_hit = true
is_onetime = true
hide_from_player = true
can_apply_to_tech_attacks = true
multiple_copies_can_stack = true

[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ssc/mf_purple_thorn/mt_blessed_bolt_system/mt_blessed_bolt_system.tres" id="11_bolt"]

; DERIVED FROM THE SPRITE ART, NOT LEFT AS THE PLACEHOLDER GRAYS (the Vauban's SP5 ruling, re-run
; here as the Naga's was). Measured 2026-09-23 with the same shader-literal test
; palette_swap_func.gdshaderinc uses (pixel == (v,0,0)/(0,v,0)/(0,0,v)/(0,v,v) for v in
; palette_index_r.png's seven red values 51, 85, 119, 153, 187, 221, 255): mf_purple_thorn.png
; (80x80, 2,327 opaque pixels - the author's own stand-in, delivered before SP1) has ZERO
; channel-encoded pixels, so this scheme is INERT on this sprite exactly like the Naga's, the
; Sluagh's, the Vauban's and the Primrose's - it cannot repaint the token at all.
; So base_0..2 hold the sprite's OWN most-common literal fill colours (a plain colour census,
; excluding the pure-black linework at 127px/0,0,0): the pale sage (169,204,186 - 35px), a dusky
; violet (105,87,102 - 9px) and a near-black slate (48,47,54 - 9px), most-used first per the
; Iskander's own slot convention. When real channel-encoded art replaces this sprite, it inherits
; a default that already looks like what the art shows today, instead of grey.
[sub_resource type="Resource" id="Resource_colorscheme"]
script = ExtResource("3_colorscheme")
base_0 = Color(0.6627451, 0.8, 0.7294118, 1)
base_1 = Color(0.41176471, 0.34117648, 0.4, 1)
base_2 = Color(0.18823529, 0.18431373, 0.21176471, 1)

[sub_resource type="Resource" id="Resource_statblock"]
script = ExtResource("2_statblock")
size = 1
structure = 4
stress = 4
health = 8
armor = 0
evasion = 10
edef = 8
speed = 3
heat = 5
save_target = 10
sensor_range = 15
tech_attack = 0
repairs = 3
systems_points = 6
reactions = 1
activations = 1

[resource]
script = ExtResource("1_frame")
default_color_scheme = SubResource("Resource_colorscheme")
sprites = Array[Texture2D]([ExtResource("9_sprite")])
; FILLED IN SHEET ORDER, ONE TASK AT A TIME (the Naga's rule). Task 1 lands the frame with NO
; traits; Task 2 appends mt_vigil, Task 3 mt_blessed_bolt_system, Task 4 cp_lav_tactical_engine -
; so the order is the sheet's. An ext_resource pointing at a file that does not exist yet would
; make this WHOLE resource fail to parse, taking the frame out of ContentLibrary with no error a
; player would ever see - which is why each entry lands only once its own files do.
; test_purple_thorn_frame.gd pins the order at the close of SP1.
traits = Array[ExtResource("8_kit")]([ExtResource("10_vigil"), ExtResource("11_bolt")])
mount_types = Array[ExtResource("4_mounttype")]([ExtResource("5_mountauxaux"), ExtResource("5_mountauxaux"), ExtResource("6_mountflex")])
stat = SubResource("Resource_statblock")
role_primary = 4

; THE HAZARD'S OWN FULL LICENCE (design 1.1, ruling 15; the IPS-N README: a full licence is a new
; file here, an alt extends). Rank 2 grants the frame; each granted_gear is filled by its own
; sub-project - SP2 (Wavemaker Grenade Launcher, Emergency Armature) at rank 1, SP3 (Panic Breaker,
; Statistical Compensator) at rank 2, SP4 (HRR-SENESCHAL, Brigid-Class NHP) at rank 3. The licence
; has no name row of its own: UnlockTree.license_name reads rank_2's granted frame
; (unlock_tree.gd:28-32), so an empty rank_2 would rename it "???" - test_hazard_frame.gd pins it.
[sub_resource type="Resource" id="Resource_rank1"]
script = ExtResource("2_unlockrank")
granted_gear = Array[ExtResource("4_kit")]([ExtResource("7_wavemaker"), ExtResource("8_armature")])

[sub_resource type="Resource" id="Resource_rank2"]
script = ExtResource("2_unlockrank")
granted_frames = Array[ExtResource("3_frame")]([ExtResource("5_mf_hazard")])
granted_gear = Array[ExtResource("4_kit")]([ExtResource("9_breaker"), ExtResource("10_compensator")])

[sub_resource type="Resource" id="Resource_rank3"]
script = ExtResource("2_unlockrank")

[resource]
script = ExtResource("1_unlocktree")
icon = ExtResource("6_icon")
rank_1 = SubResource("Resource_rank1")
rank_2 = SubResource("Resource_rank2")
rank_3 = SubResource("Resource_rank3")

[gd_resource type="Resource" script_class="UnlockTree" format=3]

[ext_resource type="Script" uid="uid://dq0jowvw37x6i" path="res://engine/character/unit_core/unlock_tree.gd" id="1_unlocktree"]
[ext_resource type="Script" uid="uid://ctb1pfqlfgmni" path="res://engine/character/unit_core/unlock_rank.gd" id="2_unlockrank"]
[ext_resource type="Script" uid="uid://daycu0mqh1rbq" path="res://engine/character/unit_core/frame.gd" id="3_frame"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ha/mf_koremasa/mf_koremasa.tres" id="4_mf_koremasa"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/ha/mf_koremasa/mf_koremasa.png" id="5_icon"]

; THE KOREMASA'S OWN LICENCE (design ruling 33): a full licence, not an alt, so a new file beside
; li_leoleth.tres rather than an extension of a vanilla one. Gear lands rank by rank as each
; sub-project builds it, in sheet order:
;   rank 1 - Makibishi Magnets, Phase Cloud (SP3)
;   rank 2 - the frame (here, SP1), Rendwire Sickle, Blinkblade Slice (SP4)
;   rank 3 - Fusionbleed shuriken, Juxtaposition Augments (SP5)
; A rank with no gear yet is still written, so UnlockTree never meets a null rank.
[sub_resource type="Resource" id="Resource_rank1"]
script = ExtResource("2_unlockrank")

[sub_resource type="Resource" id="Resource_rank2"]
script = ExtResource("2_unlockrank")
granted_frames = Array[ExtResource("3_frame")]([ExtResource("4_mf_koremasa")])

[sub_resource type="Resource" id="Resource_rank3"]
script = ExtResource("2_unlockrank")

[resource]
script = ExtResource("1_unlocktree")
; The frame's own sprite, the li_leoleth.tres convention (vanilla's li_gorgon.icon is its frame art).
icon = ExtResource("5_icon")
rank_1 = SubResource("Resource_rank1")
rank_2 = SubResource("Resource_rank2")
rank_3 = SubResource("Resource_rank3")

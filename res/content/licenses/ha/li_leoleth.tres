[resource]
script = ExtResource("1_unlocktree")
; THE SHARED STAND-IN, and a KNOWN deliberate red until SP5 (plan Departure 10):
; test_every_licence_this_mod_owns_has_a_real_icon refuses a path containing "placeholder", and a null
; icon fails the same test's other assertion. The convention, once art exists, is the frame's own
; sprite - li_sluagh.tres and li_primrose.tres both wear theirs.
icon = ExtResource("6_icon")
rank_1 = SubResource("Resource_rank1")
rank_2 = SubResource("Resource_rank2")
rank_3 = SubResource("Resource_rank3")

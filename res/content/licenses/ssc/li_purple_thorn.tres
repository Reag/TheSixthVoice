[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/ssc/mf_purple_thorn/mf_purple_thorn.tres" id="5_mf_purple_thorn"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/ssc/mf_purple_thorn/mf_purple_thorn.png" id="6_icon"]

; THE PURPLE THORN'S OWN FULL LICENCE (design 1.1, the Naga's file with the ids swapped): rank 2
; grants the frame; every granted_gear is EMPTY until the sub-project that fills that rank - SP2
; (Blink Bolt Launcher, Trajectory Arc Mapper) at rank 1, SP3 (Shredder Cannon, Pinpoint Mark) at
; rank 2, SP4 (Hyper Engineered Munitions, Superpositional Profile) at rank 3. The licence has no
; name row of its own: UnlockTree.license_name reads rank_2's granted frame and translates
; frame.mf_purple_thorn.name (unlock_tree.gd:28-32), so an empty rank_2 would rename it "???" -
; test_purple_thorn_frame.gd pins the frame's presence there.
[sub_resource type="Resource" id="Resource_rank1"]
script = ExtResource("2_unlockrank")
granted_gear = Array[ExtResource("4_kit")]([])

[sub_resource type="Resource" id="Resource_rank2"]
script = ExtResource("2_unlockrank")
granted_frames = Array[ExtResource("3_frame")]([ExtResource("5_mf_purple_thorn")])
granted_gear = Array[ExtResource("4_kit")]([])

[sub_resource type="Resource" id="Resource_rank3"]
script = ExtResource("2_unlockrank")
granted_gear = Array[ExtResource("4_kit")]([])

[resource]
script = ExtResource("1_unlocktree")
icon = ExtResource("6_icon")
rank_1 = SubResource("Resource_rank1")
rank_2 = SubResource("Resource_rank2")
rank_3 = SubResource("Resource_rank3")

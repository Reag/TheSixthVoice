[gd_resource type="Resource" script_class="UnlockTree" format=3]

[ext_resource type="Script" uid="uid://dq0jowvw37x6i" path="res://engine/character/unit_core/unlock_tree.gd" id="1_unlocktree"]
[ext_resource type="Script" uid="uid://ctb1pfqlfgmni" path="res://engine/character/unit_core/unlock_rank.gd" id="2_unlockrank"]
[ext_resource type="Script" uid="uid://daycu0mqh1rbq" path="res://engine/character/unit_core/frame.gd" id="3_frame"]
[ext_resource type="Script" uid="uid://ckrv6mvs5q65e" path="res://engine/character/gear/kit.gd" id="4_kit"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/frames/horus/mf_naga/mf_naga.tres" id="5_mf_naga"]
[ext_resource type="Texture2D" path="res://unpacked/Reag-TheSixthVoice/res/assets/frames/horus/mf_naga/mf_naga.png" id="6_icon"]
[ext_resource type="Resource" path="res://unpacked/Reag-TheSixthVoice/res/content/gear/horus/weapons/mw_shimmering_blade/mw_shimmering_blade.tres" id="7_blade"]

; THE NAGA'S OWN FULL LICENCE (design 1.1, the Leoleth's file with the ids swapped): rank 2 grants the
; frame; rank 1 carries SP2's gear (Shimmering Blade, Wide Gaze Networks), and ranks 2-3 wait for
; SP3 (Binding Fangs, Green Tide) and SP4 (Weeping Lance, Bounded Automatic Targeting Systems) fill
; them in. The licence has no name row of its own: UnlockTree.license_name reads rank_2's granted
; frame and translates frame.mf_naga.name (unlock_tree.gd:28-32), so an empty rank_2 would rename
; it "???" - test_naga_frame.gd pins the frame's presence there.
[sub_resource type="Resource" id="Resource_rank1"]
script = ExtResource("2_unlockrank")
granted_gear = Array[ExtResource("4_kit")]([ExtResource("7_blade")])

[sub_resource type="Resource" id="Resource_rank2"]
script = ExtResource("2_unlockrank")
granted_frames = Array[ExtResource("3_frame")]([ExtResource("5_mf_naga")])

[sub_resource type="Resource" id="Resource_rank3"]
script = ExtResource("2_unlockrank")

[resource]
script = ExtResource("1_unlocktree")
icon = ExtResource("6_icon")
rank_1 = SubResource("Resource_rank1")
rank_2 = SubResource("Resource_rank2")
rank_3 = SubResource("Resource_rank3")
